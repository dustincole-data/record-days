---
import { API_START } from '../lib/classify.js'

// The coda states no figure of its own. Every number a reader sees here is one just
// measured from their own query by the same modules that produced the rest of the page,
// so there is nothing in this template for the number gate to trace and the gate asserts
// exactly that. The one date the form needs is the API's first day of daily data, and it
// is read off the constant the fetch code enforces rather than typed.
---

<section class="beat coda">
  <p class="body">
    Everything above was measured once and written to a file. This last one runs live.
    Type an English Wikipedia article and the date of its event, and the page fetches the
    daily pageviews from Wikimedia and puts them through the same measurements.
  </p>

  <form id="coda-form" class="ask" novalidate>
    <div class="field">
      <label for="coda-article">Article title</label>
      <input
        id="coda-article"
        name="article"
        type="text"
        required
        autocomplete="off"
        spellcheck="false"
        placeholder="Elizabeth II"
      />
      <p class="hint">As the article URL spells it. Spaces or underscores both work.</p>
    </div>
    <div class="field">
      <label for="coda-date">Event date</label>
      <input id="coda-date" name="date" type="date" required min={API_START} />
      <p class="hint">The day the story broke, not the day you read it.</p>
    </div>
    <button id="coda-go" type="submit">Measure</button>
  </form>

  <p id="coda-status" class="status" role="status" aria-live="polite"></p>

  <figure class="fig">
    <canvas
      id="coda-band"
      class="band"
      role="img"
      aria-label="Normalised decay curves for every event in the set, with a reader's query drawn over them"
    ></canvas>
    <figcaption>
      Every event in the set, each scaled to its own peak, over the first thirty days after
      it. A query is drawn over them in black.
    </figcaption>
  </figure>

  <dl id="coda-metrics" class="metrics" hidden>
    <div class="metric">
      <dt>Peak views</dt>
      <dd data-field="peak"></dd>
    </div>
    <div class="metric">
      <dt>Days to half the lift</dt>
      <dd data-field="t50"></dd>
    </div>
    <div class="metric">
      <dt>Days to a tenth of it</dt>
      <dd data-field="t10"></dd>
    </div>
    <div class="metric wide">
      <dt>A year out</dt>
      <dd data-field="floor"></dd>
    </div>
  </dl>
</section>

<script>
  import dataset from '../data/dataset.json'
  import { drawBand } from '../scripts/band.js'
  import { lookup, MESSAGES, FLOOR_NOTES } from '../scripts/coda.js'

  const form = document.querySelector('#coda-form')
  const canvas = document.querySelector('#coda-band')
  const statusLine = document.querySelector('#coda-status')
  const metrics = document.querySelector('#coda-metrics')
  const go = document.querySelector('#coda-go')

  if (form && canvas && statusLine && metrics && go) {
    const field = (name) => metrics.querySelector(`[data-field="${name}"]`)

    // The same single ink beat 2 draws the full band in. Hue over the mass grades top to
    // bottom on a quantity this mark does not claim, and the reader's own curve has to be
    // the one thing on the canvas that reads apart from it.
    let highlight = null
    const render = () =>
      drawBand(canvas, dataset.events, { ink: '47, 107, 122', alpha: 0.22, highlight })
    // The canvas's own box, never a window resize event.
    new ResizeObserver(render).observe(canvas)
    render()

    const say = (text, tone) => {
      statusLine.textContent = text
      statusLine.dataset.tone = tone
    }

    const spanOf = (value) =>
      value === null ? 'not reached inside the window' : `${value.toFixed(2)} days`

    const show = (result) => {
      const m = result.metrics
      field('peak').textContent = `${m.peak.toLocaleString('en-US')} on the day`
      field('t50').textContent = spanOf(m.t50)
      field('t10').textContent = spanOf(m.t10)
      field('floor').textContent =
        m.floorReason === null
          ? `${(1 + m.floor).toFixed(1)} times its clean baseline`
          : FLOOR_NOTES[m.floorReason]
      metrics.hidden = false
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault()
      const article = form.elements.article.value.trim()
      const date = form.elements.date.value
      if (!article || !date) {
        say('Fill in both an article title and a date.', 'error')
        return
      }

      go.disabled = true
      metrics.hidden = true
      say('Asking Wikimedia.', 'note')
      let result
      try {
        result = await lookup(article, date)
      } catch {
        result = { ok: false, reason: 'error' }
      }
      go.disabled = false

      if (!result.ok) {
        // Never an empty chart with no message. Every failing state has a line, and the
        // one state that is not a failure is toned apart from the ones that are.
        highlight = null
        render()
        say(MESSAGES[result.reason], result.reason === 'no-spike' ? 'note' : 'error')
        return
      }

      highlight = { curve: result.curve }
      render()
      say(`${result.metrics.article}, measured live just now.`, 'note')
      show(result)
    })
  }
</script>

<style>
  .coda {
    border-top: 1px solid var(--rule);
    padding-top: 3rem;
    padding-bottom: 4rem;
  }

  .body {
    max-width: var(--measure);
    margin: 0 0 2.5rem;
    font-size: 1.06rem;
  }

  .ask {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 1.25rem;
    max-width: var(--measure);
  }

  .field {
    flex: 1 1 13rem;
    min-width: 0;
  }

  label {
    display: block;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--ink-soft);
    margin-bottom: 0.4rem;
  }

  input {
    width: 100%;
    box-sizing: border-box;
    font: inherit;
    font-size: 1rem;
    color: var(--ink);
    background: transparent;
    border: 1px solid var(--rule);
    border-radius: 2px;
    padding: 0.55rem 0.6rem;
    min-height: 2.75rem;
  }

  input:focus-visible {
    outline: 2px solid var(--above);
    outline-offset: 1px;
  }

  .hint {
    margin: 0.4rem 0 0;
    font-size: 0.82rem;
    color: var(--ink-soft);
  }

  button {
    font: inherit;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--ground);
    background: var(--ink);
    border: 1px solid var(--ink);
    border-radius: 2px;
    padding: 0.55rem 1.4rem;
    min-height: 2.75rem;
    margin-top: 1.62rem;
    cursor: pointer;
  }

  button:disabled {
    opacity: 0.45;
    cursor: default;
  }

  .status {
    max-width: var(--measure);
    min-height: 1.55rem;
    margin: 1.25rem 0 0;
    font-size: 0.95rem;
    color: var(--ink-soft);
  }

  .status[data-tone='error'] {
    color: var(--below);
  }

  .fig {
    margin: 2rem 0 0;
  }

  canvas {
    display: block;
    width: 100%;
  }

  .band {
    height: clamp(300px, 50vw, 420px);
  }

  figcaption {
    max-width: var(--measure);
    margin: 0.9rem 0 0;
    font-size: 0.92rem;
    color: var(--ink-soft);
  }

  .metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: 1.5rem 2rem;
    max-width: var(--measure);
    margin: 2.25rem 0 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
  }

  .metric.wide {
    grid-column: 1 / -1;
  }

  dt {
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--ink-soft);
  }

  dd {
    margin: 0.3rem 0 0;
    font-size: 1.02rem;
  }
</style>
