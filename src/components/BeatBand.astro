---
import probe from '../../data/probe/results2.json'

// Beat 2 states peaks and days-to-half, so it is gated against the probe output, the same
// file beat 1 draws its published figures from. The two extremes are picked from the rows
// rather than named by hand, so the caption and the drawn pair cannot drift apart.
const big = probe.reduce((a, b) => (b.peak > a.peak ? b : a))
const small = probe.reduce((a, b) => (b.peak < a.peak ? b : a))

const MONTHS = ['January', 'February', 'March', 'April', 'May', 'June',
                'July', 'August', 'September', 'October', 'November', 'December']
const longDate = (iso) => {
  const [y, m, d] = iso.split('-')
  return `${Number(d)} ${MONTHS[Number(m) - 1]} ${y}`
}
const num = (n) => n.toLocaleString('en-US')

// Pearson r between log peak views and days to half, over every probe row. The spec
// publishes -0.21; it is recomputed here so the printed figure is the file's, not a
// number typed into the copy.
const xs = probe.map((r) => Math.log10(r.peak))
const ys = probe.map((r) => r.t50)
const mx = xs.reduce((a, b) => a + b) / xs.length
const my = ys.reduce((a, b) => a + b) / ys.length
let cov = 0
let vx = 0
let vy = 0
for (let i = 0; i < xs.length; i++) {
  cov += (xs[i] - mx) * (ys[i] - my)
  vx += (xs[i] - mx) ** 2
  vy += (ys[i] - my) ** 2
}
const r = cov / Math.sqrt(vx * vy)
const rText = `${r < 0 ? '−' : '+'}${Math.abs(r).toFixed(2)}`
---

<section class="beat">
  <p class="body">
    The obvious answer is the fall. A spike that large should take longer to come down.
  </p>

  <figure class="fig">
    <canvas
      id="pair"
      class="pair"
      data-pair={JSON.stringify([big.article, small.article])}
      role="img"
      aria-label="Two normalised decay curves, the largest and the smallest peak in the set"
    ></canvas>
    <figcaption>
      {big.article}, {num(big.peak)} views on {longDate(big.event)}.{' '}
      {small.article}, {num(small.peak)} views on {longDate(small.event)}.{' '}
      The largest and the smallest peak in the set, each scaled to its own.
    </figcaption>
  </figure>

  <p class="body">
    Both lose half the lift above baseline in under a day, {big.t50} days for one
    and {small.t50} days for the other.
    They part later, and what parts them is the level, not the rate.
  </p>

  <figure class="fig">
    <canvas
      id="band"
      class="band"
      role="img"
      aria-label="Normalised decay curves for every event in the set"
    ></canvas>
    <figcaption>
      All {probe.length} events, each scaled to its own peak, over the first thirty days
      after it.
    </figcaption>
  </figure>

  <p class="body">
    This part is not new. The shape of the fall was published in <a
      href="https://doi.org/10.1038/s41562-018-0474-5">Nature Human Behaviour</a>. Its role
    here is to remove a suspect, not to claim a finding.
  </p>

  <p class="body">
    Peak size has no relationship to how fast the curve falls.
  </p>

  <figure class="fig">
    <canvas
      id="rate"
      class="rate"
      role="img"
      aria-label="Every event, peak views against the days it took to fall to half its lift"
    ></canvas>
    <figcaption>
      Peak views across the bottom, days to half up the side, one dot per event. Colour is
      peak size on a log scale, blue at the smallest peak in the set and red at the largest.
    </figcaption>
  </figure>

  <p class="body">
    The cloud has no slope.
    Across the {probe.length} events, r = {rText} between log peak views and days to half.
  </p>
</section>

<script>
  import dataset from '../data/dataset.json'
  import { drawBand, drawRateScatter, magnitudeScale } from '../scripts/band.js'

  const events = dataset.events
  // One scale wherever peak size is a colour, taken from the full set, so a hue means the
  // same magnitude on the pair as on the scatter.
  const scale = magnitudeScale(events)

  const mount = (selector, draw) => {
    const canvas = document.querySelector(selector)
    if (!canvas) return
    const render = () => draw(canvas)
    // Observe the canvas's own box, not the window. The iOS URL-bar collapse fires no
    // window resize but does change this element's height.
    new ResizeObserver(render).observe(canvas)
    render()
  }

  const pairCanvas = document.querySelector('#pair')
  const names = JSON.parse(pairCanvas?.dataset.pair ?? '[]')
  const pair = names.map((n) => events.find((e) => e.article === n)).filter(Boolean)

  if (pair.length) mount('#pair', (c) => drawBand(c, pair, { scale, alpha: 0.85 }))
  // The full band is one ink. Spec 6 allows hue over the band only if it shows no
  // ordering, and it orders: the level of a normalised curve tracks peak size by
  // arithmetic, so the mass read warm along the bottom and cool along the top. Magnitude
  // is an axis on the scatter below instead.
  mount('#band', (c) => drawBand(c, events, { ink: '47, 107, 122', alpha: 0.22 }))
  mount('#rate', (c) => drawRateScatter(c, events, { scale }))
</script>

<style>
  .beat {
    padding-bottom: 6rem;
  }

  .body {
    max-width: var(--measure);
    margin: 2rem 0 0;
    font-size: 1.06rem;
  }

  .fig {
    margin: 2.5rem 0 0;
  }

  canvas {
    display: block;
    width: 100%;
  }

  .pair {
    height: clamp(190px, 30vw, 250px);
  }

  .band {
    height: clamp(300px, 50vw, 420px);
  }

  .rate {
    height: clamp(280px, 44vw, 380px);
  }

  figcaption {
    max-width: var(--measure);
    margin: 0.9rem 0 0;
    font-size: 0.92rem;
    color: var(--ink-soft);
  }

  a {
    color: inherit;
  }
</style>
