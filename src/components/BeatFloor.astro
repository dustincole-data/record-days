---
import floors from '../../data/probe/floor.json'
import dataset from '../data/dataset.json'

// Published figures come from floor.json, which floor.py wrote for this beat. dataset.json
// keeps the unrounded quotient and differs from the probe at the printed digit on three of
// the four subjects named here, so it is used only for the count of events measured. The
// mark itself is drawn from floor.json and from the daily views in results2.json.
const pick = (name) => {
  const row = floors.find((r) => r.article === name)
  if (!row) throw new Error(`no floor.json row for ${name}`)
  return row
}

const MONTHS = ['January', 'February', 'March', 'April', 'May', 'June',
                'July', 'August', 'September', 'October', 'November', 'December']
const longDate = (iso) => {
  const [y, m, d] = iso.split('-')
  return `${Number(d)} ${MONTHS[Number(m) - 1]} ${y}`
}

const num = (n) => n.toLocaleString('en-US')

// floor.json keeps three decimals, so three of its rows land on an exact half at the
// printed digit and Elizabeth II is one of them (-0.305 -> 30.5%). Python wrote the file
// and renders such a tie to the even neighbour, JavaScript's Math.round would render it
// away from zero, and the two published percentages differ. The tie goes to even, which is
// also the digit the library's unrounded quotient for her supports.
const roundHalfEven = (x) => {
  const down = Math.trunc(x)
  const frac = x - down
  if (frac !== 0.5) return Math.round(x)
  return down % 2 === 0 ? down : down + 1
}
const pct = (row) => `${roundHalfEven(Math.abs(row.floor) * 100)}%`

const lead = pick('Elizabeth II')
const others = ['Betty White', 'Kirk Douglas', 'Prince Philip, Duke of Edinburgh'].map(pick)

const eligible = floors.length
const belowBaseline = floors.filter((r) => r.floor < 0).length
const measured = dataset.events.length
---

<section class="beat hero">
  <div class="stage">
    <div class="col">
      <p class="stat">{num(lead.peak)}</p>
      <p class="lede">people read Elizabeth II's Wikipedia page the day she died.</p>
      <p class="after">
        She died on {longDate(lead.event)}. A year later, <b>{num(lead.yr_later)}</b> a day
        read it. Before, <b>{num(lead.clean_base)}</b> a day did. That is {pct(lead)} below.
      </p>
      <p class="kick">
        {belowBaseline} of {eligible} subjects end the year below where they started.
      </p>
      <div class="key">
        <p class="swatch"><i class="warm"></i>inside the ring, read less than before</p>
        <p class="swatch"><i class="cool"></i>outside the ring, read more than before</p>
        <p class="note">
          Each thread is one subject: out to the peak, back down over sixty days, ending
          where it stood a year later.
        </p>
      </div>
    </div>
    <canvas
      id="orbit"
      class="orbit"
      role="img"
      aria-label="Every subject that carries a clean baseline, drawn as a thread running out from a ring to its peak and back down over sixty days, ending at where the page stood a year later. The ring is that page's own reading before the event."
    ></canvas>
  </div>

  <div class="ledger">
    <p class="body">The same measurement, three more subjects.</p>
    <ul class="list">
      {others.map((r) => (
        <li>
          <span class="who">{r.article}</span>
          <span class="val">{pct(r)} below</span>
        </li>
      ))}
    </ul>
    <p class="body">
      {eligible} of the {measured} events measured here can be compared against a clean
      baseline from a year before the event. {belowBaseline} of them end the year below it.
    </p>
  </div>
</section>

<script>
  import floors from '../../data/probe/floor.json'
  import probe from '../../data/probe/results2.json'
  import { orbitSubjects, mountOrbit } from '../scripts/orbit.js'

  // Named subjects the mark labels. All are rows in floor.json, and the two that end above
  // the ring are labelled on the canvas rather than in copy, which states only subjects
  // that end below it.
  const LABELS = [
    'Jeffrey Epstein',
    'Harvey Weinstein',
    'Elizabeth II',
    'Prince Philip, Duke of Edinburgh',
    'Betty White',
  ]
  const shortName = (a) => (a === 'Prince Philip, Duke of Edinburgh' ? 'Prince Philip' : a)

  const canvas = document.querySelector('#orbit')
  if (canvas) {
    const subjects = orbitSubjects(floors, probe)
    // The canvas's own box, never a window resize event.
    mountOrbit(canvas, () => ({
      subjects,
      opts: { labels: canvas.clientWidth < 560 ? [] : LABELS, shortName },
    }))
  }
</script>

<style>
  .hero {
    padding-bottom: 5rem;
  }

  .stage {
    display: grid;
    grid-template-columns: minmax(0, 23rem) minmax(0, 1fr);
    gap: 2rem;
    align-items: center;
    margin-top: 1.25rem;
  }

  .stat {
    font-size: clamp(2.75rem, 5.4vw, 4.4rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    font-variant-numeric: tabular-nums;
    line-height: 0.95;
    color: var(--below);
    margin: 0 0 0.6rem;
  }

  .lede {
    font-size: clamp(1.2rem, 1.7vw, 1.35rem);
    line-height: 1.24;
    margin: 0;
    max-width: 22ch;
  }

  .after {
    font-size: 0.95rem;
    color: var(--ink-soft);
    margin: 1.35rem 0 0;
    max-width: 34ch;
  }

  .after b {
    color: var(--ink);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }

  .kick {
    margin: 1rem 0 0;
    padding-top: 0.9rem;
    border-top: 1px solid var(--rule);
    font-size: 1rem;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }

  .key {
    margin-top: 1.5rem;
    font-size: 0.75rem;
    color: var(--ink-soft);
    line-height: 1.65;
  }

  .key p {
    margin: 0;
  }

  .key .note {
    margin-top: 0.5rem;
    max-width: 46ch;
  }

  .swatch i {
    display: inline-block;
    width: 22px;
    height: 6px;
    border-radius: 3px;
    vertical-align: middle;
    margin-right: 7px;
  }

  .warm {
    background: linear-gradient(90deg, var(--below-near), var(--below-far));
  }

  .cool {
    background: linear-gradient(90deg, var(--above-near), var(--above-far));
  }

  .orbit {
    display: block;
    width: 100%;
    height: clamp(26rem, 40vw, 41rem);
  }

  .ledger {
    margin-top: 0;
  }

  .body {
    max-width: var(--measure);
    margin: 2rem 0 0;
    font-size: 1.06rem;
  }

  .list {
    list-style: none;
    max-width: var(--measure);
    margin: 1.25rem 0 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }

  .list li {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    align-items: baseline;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .who {
    font-weight: 500;
  }

  .val {
    color: var(--below);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  @media (max-width: 62rem) {
    .stage {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.5rem;
    }

    .lede {
      max-width: 28ch;
    }

    .orbit {
      height: min(96vw, 34rem);
    }
  }
</style>
