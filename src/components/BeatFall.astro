    padding-bottom: 6rem;
  }

  .body {
    max-width: var(--measure);
    margin: 2rem 0 0;
    font-size: 1.06rem;
  }

  .fig {
    margin: 3rem 0 0;
    max-width: 64rem;
  }

  .heads,
  .ends {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: baseline;
  }

  .head {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .ends {
    font-size: 0.8rem;
    color: var(--ink-soft);
  }

  .ends.top {
    margin: 0.35rem 0 0.6rem;
  }

  .ends.bottom {
    margin-top: 0.6rem;
  }

  .start {
    text-align: left;
  }

  .mid {
    text-align: center;
  }

  .end {
    text-align: right;
  }

  .ladder {
    display: block;
    width: 100%;
    height: clamp(22rem, 36vw, 34rem);
  }

  figcaption {
    max-width: var(--measure);
    margin: 1.5rem 0 0;
    font-size: 0.92rem;
    color: var(--ink-soft);
  }

  @media (max-width: 46rem) {
    .heads,
    .ends {
      font-size: 0.68rem;
    }

    .ends {
      font-size: 0.68rem;
    }
  }
</style>
