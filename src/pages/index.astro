---
/**
 * One page. The theme sentence this is built from:
 *
 *   "Every mark is one page measured against its own quiet, laid on one axis of days since
 *    the day. This is a stopwatch, not a front page."
 *
 * What that decides, and what it throws out, is in .claude/plans/.
 *
 * COPY RULE, set by Dustin 2026-08-31 and binding on every heading, caption and title on
 * this site: say plainly what the reader is looking at. No figurative headline, no phrase
 * that has to be decoded before the graphic makes sense. A heading names the measurement;
 * a caption says what one mark is. The numbers carry the interest, not the wording.
 */
import plate from '../gen/plate.json'
import arrivalData from '../gen/arrival.json'
import settleData from '../gen/settle.json'
import groupsData from '../gen/groups.json'
import { held } from '../lib/marks/held.js'
import { arrival } from '../lib/marks/arrival.js'
import { settle } from '../lib/marks/settle.js'
import { groups } from '../lib/marks/groups.js'
import { ACCENT, INK, MUTED, HAIR } from '../lib/ink.js'
import DcdMark from '../components/DcdMark.astro'
import { SITE } from '../lib/site.js'

const first = held(plate, 1180)
const firstArrival = arrival(arrivalData, 1180)
const firstSettle = settle(settleData, 1180)
const firstGroups = groups(groupsData, 1180)
const w = plate.meta.window
const nf = new Intl.NumberFormat('en-US')
const src = `Wikimedia daily pageviews, en.wikipedia, all-access, user agents only. ${w.start} to ${w.end}. Public domain, CC0.`
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Wikipedia's Biggest Traffic Days</title>
    <meta name="description" content={`${plate.stat.all} English Wikipedia pages, each shown on the single biggest traffic day it has ever had, and how long its traffic stayed high afterwards.`} />
    <link rel="canonical" href={SITE} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/martian-mono-var-latin.woff2" />
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/schibsted-grotesk-var-latin.woff2" />
  </head>

  <body>
    <header class="head">
      <h1>Wikipedia's Biggest Traffic Days</h1>
      <p class="stand">
        <b>{plate.stat.all}</b> English Wikipedia pages, each shown on the single biggest
        traffic day it has ever had. Those days drew between
        {' '}<b>{(plate.stat.minPeak / 1e6).toFixed(1)}</b> and
        {' '}<b>{(plate.stat.maxPeak / 1e6).toFixed(1)}</b> million views, and they happened
        between {plate.stat.from} and {plate.stat.to}.
      </p>
    </header>

    <main>
      <section id="held">
        <p class="num">01</p>
        <h2>How long traffic stayed high after each record day</h2>
        <p class="deck">
          <b>{plate.stat.back}</b> of the {plate.stat.all} pages returned to their normal
          traffic level. The middle value is <b>{plate.stat.median}</b> days.
          {' '}<b>{plate.stat.holdout + plate.stat.running}</b> never returned.
        </p>

        <figure class="fig" id="held-fig">
          <div class="plate-box" id="held-plate" set:html={first.svg}></div>
          <div class="tip" id="held-tip" hidden></div>
          <figcaption>
            Each bar is one page. It runs from that page's record day to the day its traffic
            fell back under twice its normal level and stayed there for a week. Bars are sorted
            shortest to longest. A bar's colour repeats its own length, so the colour strip at
            the bottom of the chart is also the key.
          </figcaption>
        </figure>

        <details class="method">
          <summary>How this is measured</summary>
          <p>
            A page's <b>normal level</b> is the median of its daily views from
            {' '}<b>{Math.abs(plate.meta.before[0])}</b> days before its record day to
            {' '}<b>{Math.abs(plate.meta.before[1])}</b> days before it. The source file also
            offers the window 21 to 8 days before, and this site never uses it: for 45 of these
            pages traffic is already climbing by then. One definition of normal, used in every
            section.
          </p>
          <p>
            <b>{plate.stat.drawn}</b> of the {plate.stat.all} pages are drawn.
            <b>{plate.stat.noQuiet}</b> are left out because their traffic was already high
            through the whole month before their record day, so there is no normal level to
            measure them against. Of the {plate.stat.drawn} drawn,
            {' '}<b>{plate.stat.back}</b> returned to normal,
            {' '}<b>{plate.stat.holdout}</b> were tracked for a full year afterwards and were
            still above twice their normal level at the end of it, and
            {' '}<b>{plate.stat.running}</b> had a record day too recent for the file to say
            either way. Those last {plate.stat.holdout + plate.stat.running} are the block at
            the bottom of the chart; their bars run past the axis and fade out.
          </p>
          <p>
            The FIFA World Cup bar, at one day, is the least reliable number on the chart. A
            tournament runs longer than a month, so the window used for its normal level sits
            inside the tournament rather than before it. That makes its normal level too high
            and its bar too short. Its record day was
            {' '}{nf.format(plate.rows.find((r) => r.a === 'FIFA_World_Cup').peak)} views. The
            Academy Awards and WrestleMania bars are short for the same reason.
          </p>
          <p>
            These {plate.stat.all} pages were selected for having a huge day and then falling
            back from it within a week. So "traffic spikes and then falls" is how the set was
            chosen, not something this chart found. Nothing on this page rests on that: every
            number here is read either the day before the record day or more than 180 days
            after it, and the selection looks at neither.
          </p>
          <p>
            On a screen narrower than about 640 pixels the shortest bars are drawn at a
            minimum width of 1.2 pixels, so one day and two days cannot be told apart there.
            Every other bar is drawn at its true length.
          </p>
        </details>

        <p class="src">{src}</p>
      </section>

      <section id="arrival">
        <p class="num">02</p>
        <h2>How much traffic each page had the day before its record day</h2>
        <p class="deck">
          The day before, half of these pages were getting under
          {' '}<b>65,000</b> views. <b>{arrivalData.stat.under1000}</b> were getting fewer than
          {' '}<b>1,000</b>. Pope Leo XIV's page was getting <b>{arrivalData.pope.before}</b>.
        </p>

        <figure class="fig" id="arrival-fig">
          <div class="plate-box" id="arrival-plate" set:html={firstArrival.svg}></div>
          <figcaption>
            Each tick is one page. Ticks below the scale are that page's views the day before
            its record day. Ticks above the scale are the record day itself. Every step along
            the scale is ten times the one before it.
          </figcaption>
        </figure>

        <details class="method">
          <summary>How this is measured</summary>
          <p>
            The day before means the one calendar day before the record day, not an average of
            several. Half of these pages got at least
            {' '}<b>{arrivalData.stat.medianTimes}</b> times more views on the record day than
            they had the day before.
          </p>
          <p>
            The upper field covers a single tenfold step of the scale, from
            {' '}{nf.format(arrivalData.stat.minPeak)} to {nf.format(arrivalData.stat.maxPeak)}
            {' '}views. The lower field covers nearly six of them, from
            {' '}{arrivalData.stat.minBefore} views to {nf.format(arrivalData.stat.maxBefore)}.
            That difference in spread is what this chart is showing.
          </p>
          <p>
            One page runs the other way. {arrivalData.stat.reversedName} got
            {' '}{nf.format(arrivalData.rows.find((r) => r.t === arrivalData.stat.reversedName).before)}
            {' '}views the day before and
            {' '}{nf.format(arrivalData.rows.find((r) => r.t === arrivalData.stat.reversedName).peak)}
            {' '}on the day. A page's record day here is the largest day the daily top-1000
            ranking recorded for it, and for this one page its own daily series carries a
            larger day one day earlier.
          </p>
          <p>
            A view is not a person. The source counts pageviews and does not identify readers,
            so one person loading a page ten times counts ten times.
          </p>
        </details>

        <p class="src">{src}</p>
      </section>

      <section id="settle">
        <p class="num">03</p>
        <h2>Where each page's traffic settled 300 to 340 days after its record day</h2>
        <p class="deck">
          <b>{settleData.stat.n}</b> of the {settleData.stat.all} pages can be measured this
          way. <b>{settleData.stat.above}</b> of them, <b>{settleData.stat.aboveRounded}</b>
          {' '}percent, were still getting more traffic than they had before the record day.
        </p>

        <figure class="fig" id="settle-fig">
          <div class="plate-box" id="settle-plate" set:html={firstSettle.svg}></div>
          <div class="tip" id="settle-tip" hidden></div>
          <figcaption>
            Each square is one page. Its place on the scale is its daily traffic 300 to 340
            days after the record day, divided by its normal traffic before it. Squares to the
            right of the marked line ended busier than they started.
          </figcaption>
        </figure>

        <details class="method">
          <summary>How this is measured</summary>
          <p>
            Normal level is the same one used in every section: the median of a page's daily
            views from {Math.abs(settleData.meta.before[0])} to
            {' '}{Math.abs(settleData.meta.before[1])} days before its record day. The settled
            level is the median of days {settleData.meta.after[0]} to
            {' '}{settleData.meta.after[1]} after it. A page needs both windows to be drawn
            here, which is why {settleData.stat.n} of the {settleData.stat.all} are.
          </p>
          <p>
            <b>{settleData.stat.above2}</b> pages ended above twice their normal level and
            {' '}<b>{settleData.stat.above5}</b> above five times it.
          </p>
          <p>
            {settleData.stat.scheduledInWorst10} of the 10 pages furthest to the left are
            scheduled events: a World Cup, two WrestleManias, a Royal Rumble and an Academy
            Awards. Those events run longer than a month, so the window used for their normal
            level sits inside the event rather than before it, and the level they are measured
            against is too high. Their squares sit further left than they should.
          </p>
          <p>
            Squares are grouped into bins of equal width on this scale, and the number of bins
            follows the width of the chart, so the shape is coarser on a phone. The two counts
            either side of the line do not depend on the bins.
          </p>
        </details>

        <p class="src">{src}</p>
      </section>

      <section id="groups">
        <p class="num">04</p>
        <h2>Where traffic settled, grouped by how much traffic the page had the day before</h2>
        <p class="deck">
          The same {groupsData.stat.n} pages, ordered by their traffic the day before as a
          share of the record day, then cut into five equal groups. The middle page of the
          quietest fifth settled at <b>{groupsData.groups[0].median}</b> times its normal
          level. The other four groups settled below theirs.
        </p>

        <figure class="fig" id="groups-fig">
          <div class="plate-box" id="groups-plate" set:html={firstGroups.svg}></div>
          <figcaption>
            Each shape is one group of 39 or 40 pages, on the same scale as the chart above.
            Taller means more of that group's pages sat at that point on the scale. The
            vertical mark on each shape is that group's middle value.
          </figcaption>
        </figure>

        <details class="method">
          <summary>How this is measured</summary>
          <p>
            The day before is read as a share of the record day itself, so a page that got
            1,000 views the day before a 1,000,000 view day counts as 0.1 percent. The
            quietest fifth were at <b>{groupsData.stat.quietestHiText}</b> or less. The busiest
            fifth were at <b>{groupsData.stat.busiestLoText}</b> or more.
          </p>
          <p>
            The five groups do not fall in order. The busiest fifth settles at
            {' '}<b>{groupsData.groups[4].median}</b>, slightly above the fourth group at
            {' '}<b>{groupsData.groups[3].median}</b>. What holds across the five is narrower:
            the quietest fifth is the only group whose middle page ended above its own normal
            level, and the only group where most pages did
            {' '}({groupsData.groups[0].abovePct} percent of it).
          </p>
          <p>
            Cutting the same {groupsData.stat.n} pages at fixed thresholds instead of into
            fifths gives the same picture. Pages at under
            {' '}{groupsData.test.cut[0] * 100} percent of their record day the day before
            (n = {groupsData.test.ambush.n}) have a middle value of
            {' '}{groupsData.test.ambush.median}; pages at over
            {' '}{groupsData.test.cut[1] * 100} percent (n = {groupsData.test.warned.n}) have
            {' '}{groupsData.test.warned.median}. A Mann-Whitney test on those two sets gives
            {' '}z = {groupsData.test.z}, p = {groupsData.test.p.toExponential(1)}.
          </p>
          <p>
            The shapes are smoothed over {groupsData.meta.bw} of a tenfold step, on one
            vertical scale shared by all five, so a group with more pages at one value stands
            taller. Nothing on this page rests on a bump in a shape. The medians, the counts
            and the test above are the numbers.
          </p>
        </details>

        <p class="src">{src}</p>
      </section>
    </main>

    <DcdMark />

    <style define:vars={{ accent: ACCENT, ink: INK, muted: MUTED, hair: HAIR }}>
      :root { color-scheme: light; }
      html { -webkit-text-size-adjust: 100%; }
      body {
        margin: 0;
        background: #fff;
        color: var(--ink);
        font-family: 'Schibsted Grotesk', -apple-system, 'Segoe UI', Helvetica, Arial, sans-serif;
        font-size: 16px;
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
      }
      .head, main, .src { max-width: 1240px; margin: 0 auto; }
      .head { padding: 56px 24px 8px; }
      h1 {
        font-family: 'Martian Mono', ui-monospace, monospace;
        font-weight: 600;
        font-size: 26px;
        letter-spacing: -0.02em;
        margin: 0;
      }
      .stand { margin: 10px 0 0; max-width: 58ch; color: var(--muted); font-size: 16px; }
      .stand b { color: var(--ink); font-weight: 500; }

      section { padding: 44px 24px 8px; }
      .num {
        font-family: 'Martian Mono', ui-monospace, monospace;
        font-size: 14px; font-weight: 600; letter-spacing: 0.06em;
        color: var(--accent); margin: 0 0 10px;
      }
      h2 { font-size: 30px; font-weight: 500; letter-spacing: -0.02em; margin: 0; max-width: 52ch; }
      .deck { margin: 10px 0 26px; max-width: 52ch; color: var(--muted); font-size: 17px; }
      .deck b { color: var(--ink); font-weight: 500; font-family: 'Martian Mono', ui-monospace, monospace; font-size: 15px; }

      .fig { margin: 0; position: relative; }
      .plate-box { width: 100%; }
      .plate { display: block; width: 100%; height: auto; }
      figcaption {
        margin: 16px 0 0; max-width: 62ch; color: var(--muted); font-size: 14px; line-height: 1.45;
      }

      .method { margin: 26px 0 0; border-top: 1px solid var(--hair); max-width: 68ch; }
      .method summary {
        cursor: pointer; padding: 12px 0; font-size: 14px; color: var(--muted);
        list-style: none;
      }
      .method summary::-webkit-details-marker { display: none; }
      .method summary::before { content: '+ '; color: var(--accent); font-weight: 600; }
      .method[open] summary::before { content: '\2212 '; }
      .method summary:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
      .method p { margin: 0 0 12px; font-size: 14px; line-height: 1.55; color: var(--muted); }
      .method b { color: var(--ink); font-weight: 500; font-family: 'Martian Mono', ui-monospace, monospace; }

      .src { padding: 20px 24px 44px; font-size: 14px; color: var(--muted); }

      .tip {
        position: absolute; z-index: 3; pointer-events: none;
        background: #fff; border: 1px solid var(--hair);
        padding: 6px 9px; font-size: 14px; line-height: 1.25; white-space: nowrap;
        box-shadow: 0 2px 10px rgba(22, 24, 29, 0.10);
      }

      @media (max-width: 639px) {
        .head { padding: 34px 16px 4px; }
        h1 { font-size: 21px; }
        .stand { font-size: 15px; }
        section { padding: 30px 16px 6px; }
        h2 { font-size: 23px; }
        .deck { font-size: 16px; margin-bottom: 20px; }
        .deck b { font-size: 14px; }
        .src { padding: 16px 16px 34px; font-size: 13px; }
        figcaption, .method p, .method summary, .tip { font-size: 13px; }
      }
      @media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
    </style>

    <style is:global>
      @font-face {
        font-family: 'Martian Mono'; font-style: normal; font-weight: 400 700; font-display: swap;
        src: url('/fonts/martian-mono-var-latin.woff2') format('woff2');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: 'Martian Mono'; font-style: normal; font-weight: 400 700; font-display: swap;
        src: url('/fonts/martian-mono-var-latin-ext.woff2') format('woff2');
        unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+1E00-1E9F, U+1EF2-1EFF, U+2C60-2C7F, U+A720-A7FF;
      }
      @font-face {
        font-family: 'Schibsted Grotesk'; font-style: normal; font-weight: 400 700; font-display: swap;
        src: url('/fonts/schibsted-grotesk-var-latin.woff2') format('woff2');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: 'Schibsted Grotesk'; font-style: normal; font-weight: 400 700; font-display: swap;
        src: url('/fonts/schibsted-grotesk-var-latin-ext.woff2') format('woff2');
        unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+1E00-1E9F, U+1EF2-1EFF, U+2C60-2C7F, U+A720-A7FF;
      }
      @font-face {
        font-family: 'Archivo'; font-style: normal; font-weight: 600; font-display: swap;
        src: url('/fonts/archivo-latin-600-normal.woff2') format('woff2');
      }

      /* The plate and the readout are injected as markup, so their type is styled globally
         rather than scoped: Astro's scope attribute never reaches a node made by innerHTML. */
      .tip b { font-weight: 500; }
      .tip i {
        font-style: normal; font-family: 'Martian Mono', ui-monospace, monospace;
        font-size: 14px; color: #B31E63;
      }
      @media (max-width: 639px) { .tip i { font-size: 13px; } }
      /* The plate is injected as markup, so its type is styled globally rather than scoped. */
      .plate text {
        font-family: 'Schibsted Grotesk', -apple-system, 'Segoe UI', Helvetica, Arial, sans-serif;
        paint-order: stroke fill;
        stroke: #fff;
        stroke-width: 3px;
        stroke-linejoin: round;
      }
      /* Size is emitted on each element by src/lib/marks/held.js, never set here: a CSS
         breakpoint measures the viewport and the mark measures its own box, and the two
         disagree by the page margins. */
      .plate .m-name { font-weight: 500; }
      .plate .m-fig,
      .plate .m-tick,
      .plate .m-note { font-family: 'Martian Mono', ui-monospace, monospace; }
      .plate .m-note { font-weight: 600; }
      .plate .m-rows path,
      .plate .m-rows rect { transition: opacity 120ms linear; }
      .plate.lit .m-rows path,
      .plate.lit .m-rows rect { opacity: 0.42; }
      .plate.lit .m-rows path.on,
      .plate.lit .m-rows rect.on { opacity: 1; }

      @media (prefers-reduced-motion: reduce) {
        .plate .m-rows path, .plate .m-rows rect { transition: none; }
      }
    </style>

    <script>
      import plate from '../gen/plate.json'
      import arrivalData from '../gen/arrival.json'
      import settleData from '../gen/settle.json'
      import groupsData from '../gen/groups.json'
      import { held } from '../lib/marks/held.js'
      import { arrival } from '../lib/marks/arrival.js'
      import { settle } from '../lib/marks/settle.js'
      import { groups } from '../lib/marks/groups.js'

      // Draw at the width the reader actually has. The server render is one width and any
      // other width would be that drawing stretched, which moves every label off its gate size.
      const PLATES = [
        ['held-plate', plate, held],
        ['arrival-plate', arrivalData, arrival],
        ['settle-plate', settleData, settle],
        ['groups-plate', groupsData, groups],
      ]
      for (const [id, data, mark] of PLATES) {
        const box = document.getElementById(id)
        if (!box) continue
        let last = 0
        const draw = () => {
          const w = Math.round(box.clientWidth)
          if (!w || w === last) return
          last = w
          box.innerHTML = mark(data, w).svg
        }
        draw()
        // The box, not the window: a phone's URL bar resizes the viewport without resizing this.
        new ResizeObserver(draw).observe(box)
      }

      // Pointing at a mark lights it and dims its field. Only the two plates whose marks are
      // one page each carry it: a tick in a rug and a shape over forty pages are not rows a
      // readout can name.
      for (const key of ['held', 'settle']) {
        const box = document.getElementById(key + '-plate')
        const fig = document.getElementById(key + '-fig')
        const tip = document.getElementById(key + '-tip')
        if (!box || !fig || !tip) continue

        const clear = () => {
          const svg = box.querySelector('svg')
          if (svg) { svg.classList.remove('lit'); svg.querySelectorAll('.on').forEach((n) => n.classList.remove('on')) }
          tip.hidden = true
        }

        box.addEventListener('pointermove', (e) => {
          const hit = e.target.closest('.m-rows [data-t]')
          const svg = box.querySelector('svg')
          if (!hit || !svg) return clear()
          svg.classList.add('lit')
          svg.querySelectorAll('.on').forEach((n) => n.classList.remove('on'))
          hit.classList.add('on')
          tip.innerHTML = '<b>' + hit.dataset.t + '</b> &nbsp;<i>' + hit.dataset.v + '</i>'
          tip.hidden = false
          const r = fig.getBoundingClientRect()
          const tw = tip.offsetWidth
          tip.style.left = Math.max(0, Math.min(r.width - tw, e.clientX - r.left + 14)) + 'px'
          tip.style.top = (e.clientY - r.top - 34) + 'px'
        })
        box.addEventListener('pointerleave', clear)
        // On touch there is no pointerleave. A scroll that starts on the plate ends as a cancel.
        box.addEventListener('pointercancel', clear)
        window.addEventListener('scroll', clear, { passive: true })
      }
    </script>
  </body>
</html>
