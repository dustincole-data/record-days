---
/**
 * One page. The theme sentence this is built from:
 *
 *   "Every mark is one page measured against its own quiet, laid on one axis of days since
 *    the day. This is a stopwatch, not a front page."
 *
 * What that decides, and what it throws out, is in .claude/plans/.
 *
 * COPY RULE, set by Dustin 2026-08-31 and binding on every heading, caption and title on
 * this site: say plainly what the reader is looking at. No figurative headline, no phrase
 * that has to be decoded before the graphic makes sense. A heading names the measurement;
 * a caption says what one mark is. The numbers carry the interest, not the wording.
 */
import plate from '../gen/plate.json'
import arrivalData from '../gen/arrival.json'
import settleData from '../gen/settle.json'
import groupsData from '../gen/groups.json'
import artefactData from '../gen/artefact.json'
import weekdayData from '../gen/weekday.json'
import sharedData from '../gen/shared.json'
import returnData from '../gen/return.json'
import windowData from '../gen/window.json'
import agreeData from '../gen/agree.json'
import stopData from '../gen/stop.json'
import { held } from '../lib/marks/held.js'
import { arrival } from '../lib/marks/arrival.js'
import { settle } from '../lib/marks/settle.js'
import { groups } from '../lib/marks/groups.js'
import { artefact } from '../lib/marks/artefact.js'
import { weekday } from '../lib/marks/weekday.js'
import { shared } from '../lib/marks/shared.js'
import { annual } from '../lib/marks/return.js'
import { windows } from '../lib/marks/window.js'
import { agree } from '../lib/marks/agree.js'
import { stop } from '../lib/marks/stop.js'
import { ACCENT, INK, MUTED, HAIR } from '../lib/ink.js'
import DcdMark from '../components/DcdMark.astro'
import { SITE } from '../lib/site.js'

const first = held(plate, 1180)
const firstArrival = arrival(arrivalData, 1180)
const firstSettle = settle(settleData, 1180)
const firstGroups = groups(groupsData, 1180)
const firstArtefact = artefact(artefactData, 1180)
const firstWeekday = weekday(weekdayData, 1180)
const firstShared = shared(sharedData, 1180)
const firstReturn = annual(returnData, 1180)
const firstWindow = windows(windowData, 1180)
const firstAgree = agree(agreeData, 1180)
const firstStop = stop(stopData, 1180)
const ten = artefactData.panels.filter((p) => p.group === 'scheduled')
const MON = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec']
const shortDate = (iso) => +iso.slice(8, 10) + ' ' + MON[+iso.slice(5, 7) - 1] + ' ' + iso.slice(0, 4)
const w = plate.meta.window
const nf = new Intl.NumberFormat('en-US')
const src = `Wikimedia daily pageviews, en.wikipedia, all-access, user agents only. ${w.start} to ${w.end}. Public domain, CC0.`

// The site's name, and the one sentence that says what it is. Both are read three times each
// -- the tab, the card, the header -- so they are written once here.
const NAME = 'Record Days'
const TITLE = `${NAME} — the biggest traffic day of ${plate.stat.all} Wikipedia pages`
const DESC = `${plate.stat.all} English Wikipedia pages, each shown on the single biggest traffic ` +
  `day it has ever had, and how long its traffic stayed high afterwards. Of the ${plate.stat.back} ` +
  `that came back to their normal level, the middle one took ${plate.stat.median} days. ` +
  `${plate.stat.holdout + plate.stat.running} never came back.`
const CARD = `${SITE}/og.png`
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{TITLE}</title>
    <meta name="description" content={DESC} />
    <link rel="canonical" href={SITE} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={NAME} />
    <meta property="og:url" content={SITE} />
    <meta property="og:title" content={TITLE} />
    <meta property="og:description" content={DESC} />
    <meta property="og:image" content={CARD} />
    <meta property="og:image:width" content="2400" />
    <meta property="og:image:height" content="1260" />
    <meta property="og:image:alt" content={`Bar chart. ${plate.stat.drawn} Wikipedia pages, one bar each, sorted shortest to longest, showing how many days each took to return to its normal traffic level after its record day.`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={TITLE} />
    <meta name="twitter:description" content={DESC} />
    <meta name="twitter:image" content={CARD} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/martian-mono-var-latin.woff2" />
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/schibsted-grotesk-var-latin.woff2" />
  </head>

  <body>
    <header class="head">
      <h1>{NAME}</h1>
      <p class="stand">
        <b>{plate.stat.all}</b> English Wikipedia pages, each shown on the single biggest
        traffic day it has ever had, and how long its traffic stayed high afterwards. Those
        days drew between
        {' '}<b>{(plate.stat.minPeak / 1e6).toFixed(1)}</b> and
        {' '}<b>{(plate.stat.maxPeak / 1e6).toFixed(1)}</b> million views, and they happened
        between {plate.stat.from} and {plate.stat.to}.
      </p>
    </header>

    <main>
      <section id="held">
        <p class="num">01</p>
        <h2>How long traffic stayed high after each record day</h2>
        <p class="deck">
          <b>{plate.stat.back}</b> of the {plate.stat.all} pages returned to their normal
          traffic level. The middle value is <b>{plate.stat.median}</b> days.
          {' '}<b>{plate.stat.holdout + plate.stat.running}</b> never returned.
        </p>

        <figure class="fig" id="held-fig">
          <div class="plate-box" id="held-plate" set:html={first.svg}></div>
          <div class="tip" id="held-tip" hidden></div>
          <figcaption>
            Each bar is one page. It runs from that page's record day to the day its traffic
            fell back under twice its normal level and stayed there for a week. Bars are sorted
            shortest to longest. A bar's colour repeats its own length, so the colour strip at
            the bottom of the chart is also the key.
          </figcaption>
        </figure>

        <details class="method">
          <summary>How this is measured</summary>
          <p>
            A page's <b>normal level</b> is the median of its daily views from
            {' '}<b>{Math.abs(plate.meta.before[0])}</b> days before its record day to
            {' '}<b>{Math.abs(plate.meta.before[1])}</b> days before it. The source file also
            offers the window 21 to 8 days before, and this site never uses it: for 45 of these
            pages traffic is already climbing by then. One definition of normal, used in every
            section.
          </p>
          <p>
            <b>{plate.stat.drawn}</b> of the {plate.stat.all} pages are drawn.
            <b>{plate.stat.noQuiet}</b> are left out because their traffic was already high
            through the whole month before their record day, so there is no normal level to
            measure them against. Of the {plate.stat.drawn} drawn,
            {' '}<b>{plate.stat.back}</b> returned to normal,
            {' '}<b>{plate.stat.holdout}</b> were tracked for a full year afterwards and were
            still above twice their normal level at the end of it, and
            {' '}<b>{plate.stat.running}</b> had a record day too recent for the file to say
            either way. Those last {plate.stat.holdout + plate.stat.running} are the block at
            the bottom of the chart; their bars run past the axis and fade out.
          </p>
          <p>
            The FIFA World Cup bar, at one day, is the least reliable number on the chart. A
            tournament runs longer than a month, so the window used for its normal level sits
            inside the tournament rather than before it. That makes its normal level too high
            and its bar too short. Its record day was
            {' '}{nf.format(plate.rows.find((r) => r.a === 'FIFA_World_Cup').peak)} views. The
            Academy Awards and WrestleMania bars are short for the same reason.
          </p>
          <p>
            These {plate.stat.all} pages were selected for having a huge day and then falling
            back from it within a week. So "traffic spikes and then falls" is how the set was
            chosen, not something this chart found. Nothing on this page rests on that: every
            number here is read either the day before the record day or more than 180 days
            after it, and the selection looks at neither.
          </p>
          <p>
            On a screen narrower than about 640 pixels the shortest bars are drawn at a
            minimum width of 1.2 pixels, so one day and two days cannot be told apart there.
            Every other bar is drawn at its true length.
          </p>
        </details>

        <p class="src">{src}</p>
      </section>

      <section id="arrival">
        <p class="num">02</p>
        <h2>How much traffic each page had the day before its record day</h2>
        <p class="deck">
          The day before, half of these pages were getting under
          {' '}<b>65,000</b> views. <b>{arrivalData.stat.under1000}</b> were getting fewer than
          {' '}<b>1,000</b>. Pope Leo XIV's page was getting <b>{arrivalData.pope.before}</b>.
        </p>

        <figure class="fig" id="arrival-fig">
          <div class="plate-box" id="arrival-plate" set:html={firstArrival.svg}></div>
          <figcaption>
            Each tick is one page. Ticks below the scale are that page's views the day before
            its record day. Ticks above the scale are the record day itself. Every step along
            the scale is ten times the one before it.
          </figcaption>
        </figure>

        <details class="method">
          <summary>How this is measured</summary>
          <p>
            The day before means the one calendar day before the record day, not an average of
            several. Half of these pages got at least
            {' '}<b>{arrivalData.stat.medianTimes}</b> times more views on the record day than
            they had the day before.
          </p>
          <p>
            The upper field covers a single tenfold step of the scale, from
            {' '}{nf.format(arrivalData.stat.minPeak)} to {nf.format(arrivalData.stat.maxPeak)}
            {' '}views. The lower field covers nearly six of them, from
            {' '}{arrivalData.stat.minBefore} views to {nf.format(arrivalData.stat.maxBefore)}.
            That difference in spread is what this chart is showing.
          </p>
          <p>
            One page runs the other way. {arrivalData.stat.reversedName} got
            {' '}{nf.format(arrivalData.rows.find((r) => r.t === arrivalData.stat.reversedName).before)}
            {' '}views the day before and
            {' '}{nf.format(arrivalData.rows.find((r) => r.t === arrivalData.stat.reversedName).peak)}
            {' '}on the day. A page's record day here is the largest day the daily top-1000
            ranking recorded for it, and for this one page its own daily series carries a
            larger day one day earlier.
          </p>
          <p>
            A view is not a person. The source counts pageviews and does not identify readers,
            so one person loading a page ten times counts ten times.
          </p>
        </details>

        <p class="src">{src}</p>
      </section>

      <section id="settle">
        <p class="num">03</p>
        <h2>Where each page's traffic settled 300 to 340 days after its record day</h2>
        <p class="deck">
          <b>{settleData.stat.n}</b> of the {settleData.stat.all} pages can be measured this
          way. <b>{settleData.stat.above}</b> of them, <b>{settleData.stat.aboveRounded}</b>
          {' '}percent, were still getting more traffic than they had before the record day.
        </p>

        <figure class="fig" id="settle-fig">
          <div class="plate-box" id="settle-plate" set:html={firstSettle.svg}></div>
          <div class="tip" id="settle-tip" hidden></div>
          <figcaption>
            Each square is one page. Its place on the scale is its daily traffic 300 to 340
            days after the record day, divided by its normal traffic before it. Squares to the
            right of the marked line ended busier than they started. The two squares furthest
            to the left are pages that were renamed during the year, so the label marks the
            page furthest left whose title did not change.
          </figcaption>
        </figure>

        <details class="method">
          <summary>How this is measured</summary>
          <p>
            Normal level is the same one used in every section: the median of a page's daily
            views from {Math.abs(settleData.meta.before[0])} to
            {' '}{Math.abs(settleData.meta.before[1])} days before its record day. The settled
            level is the median of days {settleData.meta.after[0]} to
            {' '}{settleData.meta.after[1]} after it. A page needs both windows to be drawn
            here, which is why {settleData.stat.n} of the {settleData.stat.all} are.
          </p>
          <p>
            <b>{settleData.stat.above2}</b> pages ended above twice their normal level and
            {' '}<b>{settleData.stat.above5}</b> above five times it.
          </p>
          <p>
            {settleData.stat.scheduledInWorst10} of the 10 pages furthest to the left are
            scheduled events: a World Cup, two WrestleManias, a Royal Rumble and an Academy
            Awards. Those events run longer than a month, so the window used for their normal
            level sits inside the event rather than before it, and the level they are measured
            against is too high. Their squares sit further left than they should.
          </p>
          <p>
            <b>{settleData.stat.moved}</b> of these pages were renamed during the year measured
            here. Wikipedia keeps counting the old title, which after a move receives almost
            nothing, so those pages read as abandoned when what changed was the name. The two
            furthest left are both moves: {settleData.moves[0].t} at
            {' '}<b>{settleData.moves[0].text}</b> its normal level and {settleData.moves[1].t}
            {' '}at <b>{settleData.moves[1].text}</b>. They are drawn, because the move is real
            and dropping rows would change the count rather than correct it. Without all
            {' '}{settleData.stat.moved} of them, <b>{settleData.stat.stayedAbove}</b> of
            {' '}{settleData.stat.stayed} pages end above their normal level, which is
            {' '}<b>{settleData.stat.stayedAbovePct}</b> percent rather than
            {' '}<b>{settleData.stat.abovePct}</b>.
          </p>
          <p>
            Squares are grouped into bins of equal width on this scale, and the number of bins
            follows the width of the chart, so the shape is coarser on a phone. The two counts
            either side of the line do not depend on the bins.
          </p>
        </details>

        <p class="src">{src}</p>
      </section>

      <section id="groups">
        <p class="num">04</p>
        <h2>Where traffic settled, grouped by how much traffic the page had the day before</h2>
        <p class="deck">
          The same {groupsData.stat.n} pages, ordered by their traffic the day before as a
          share of the record day, then cut into five equal groups. The middle page of the
          quietest fifth settled at <b>{groupsData.groups[0].median}</b> times its normal
          level. The other four groups settled below theirs.
        </p>

        <figure class="fig" id="groups-fig">
          <div class="plate-box" id="groups-plate" set:html={firstGroups.svg}></div>
          <figcaption>
            Each shape is one group of 39 or 40 pages, on the same scale as the chart above.
            Taller means more of that group's pages sat at that point on the scale. The
            vertical mark on each shape is that group's middle value.
          </figcaption>
        </figure>

        <details class="method">
          <summary>How this is measured</summary>
          <p>
            The day before is read as a share of the record day itself, so a page that got
            1,000 views the day before a 1,000,000 view day counts as 0.1 percent. The
            quietest fifth were at <b>{groupsData.stat.quietestHiText}</b> or less. The busiest
            fifth were at <b>{groupsData.stat.busiestLoText}</b> or more.
          </p>
          <p>
            The five groups do not fall in order. The busiest fifth settles at
            {' '}<b>{groupsData.groups[4].median}</b>, slightly above the fourth group at
            {' '}<b>{groupsData.groups[3].median}</b>. What holds across the five is narrower:
            the quietest fifth is the only group whose middle page ended above its own normal
            level, and the only group where most pages did
            {' '}({groupsData.groups[0].abovePct} percent of it).
          </p>
          <p>
            Cutting the same {groupsData.stat.n} pages at fixed thresholds instead of into
            fifths gives the same picture. Pages at under
            {' '}{groupsData.test.cut[0] * 100} percent of their record day the day before
            (n = {groupsData.test.ambush.n}) have a middle value of
            {' '}{groupsData.test.ambush.median}; pages at over
            {' '}{groupsData.test.cut[1] * 100} percent (n = {groupsData.test.warned.n}) have
            {' '}{groupsData.test.warned.median}. A Mann-Whitney test on those two sets gives
            {' '}z = {groupsData.test.z}, p = {groupsData.test.p.toExponential(1)}.
          </p>
          <p>
            The shapes are smoothed over {groupsData.meta.bw} of a tenfold step, on one
            vertical scale shared by all five, so a group with more pages at one value stands
            taller. Nothing on this page rests on a bump in a shape. The medians, the counts
            and the test above are the numbers.
          </p>
        </details>

        <p class="src">{src}</p>
      </section>
      <section id="artefact">
        <p class="num">05</p>
        <h2>How much traffic these pages already had in the month before their record day</h2>
        <p class="deck">
          The source file measures each page against its traffic 21 to 8 days before the record
          day. For <b>{artefactData.stat.climbing}</b> of the
          {' '}{artefactData.stat.testable} pages that can be checked, traffic is already
          climbing by then. For <b>{artefactData.stat.belowGate}</b> it is so far inside the
          event that the file's own test reads them as never having risen at all.
        </p>

        <figure class="fig" id="artefact-fig">
          <div class="plate-box" id="artefact-plate" set:html={firstArtefact.svg}></div>
          <figcaption>
            Each small chart is one page. The line is its views that day divided by its own
            record day, on one scale shared by all twenty, so a line near the top of a panel
            means that page was already being read almost as much as it was on its record day.
            The two shaded bands are the two windows a normal level can be taken from: the
            earlier band, 30 to 22 days before, is the one this page uses everywhere; the later
            band, 21 to 8 days before, is the one the source file offers. The dashed line is the
            level the file reads across the later band, and the second dot is day seven.
          </figcaption>
        </figure>

        <details class="method">
          <summary>How this is measured</summary>
          <p>
            The source file keeps a page only if, a week after its record day, it is still
            visibly raised. One arm of that test is day seven divided by the median of days 21
            to 8 before. For these {artefactData.stat.belowGate} pages that comes out
            {' '}<b>under 1</b>, from {ten[0].t} at <b>{ten[0].gate}</b> to {ten[9].t} at
            {' '}<b>{ten[9].gate}</b>, because the window it is divided by sits inside the event
            rather than before it. Every one of the ten is a scheduled event:
            {' '}{ten.map((p) => p.t).join(', ')}.
          </p>
          <p>
            That is a fact about day seven, not about the record day. On the window this page
            uses, days {Math.abs(artefactData.meta.far[0])} to
            {' '}{Math.abs(artefactData.meta.far[1])} before, every one of those ten record days
            is between <b>2.67</b> and <b>122</b> times its own normal level.
          </p>
          <p>
            Moving the window further from the event does not always help. For
            {' '}<b>{artefactData.stat.noCleaner}</b> of the ten the earlier window is no lower
            than the later one, and for <b>{artefactData.stat.readsMateriallyHigher}</b> it is
            higher: the FIFA World Cup page was read
            {' '}<b>{nf.format(artefactData.stat.worldCupFar)}</b> times a day 30 to 22 days
            before the final and <b>{nf.format(artefactData.stat.worldCupNear)}</b> times a day
            21 to 8 days before it, against
            {' '}{nf.format(artefactData.stat.worldCupPeak)} on the day. A tournament runs longer
            than a month, so there is no quiet reading anywhere in the 30 days this file carries.
          </p>
          <p>
            The bottom ten are not a hand-picked opposite. They are the ten pages in the file
            with the least traffic the day before their record day, out of those that have a
            usable normal level that is not already climbing. Every one of the top ten sat above
            {' '}<b>1 percent</b> of its record day through the later window and every one of the
            bottom ten sat below it, so the two blocks do not overlap on that reading.
          </p>
          <p>
            This section is the reason every other section on this page uses days 30 to 22
            before, and never the window the file offers.
          </p>
        </details>

        <p class="src">{src}</p>
      </section>

      <section id="weekday">
        <p class="num">06</p>
        <h2>Which day of the week these record days landed on</h2>
        <p class="deck">
          Monday holds <b>{weekdayData.record.count[1]}</b> of the {weekdayData.stat.n} record
          days against <b>{weekdayData.record.expect[1]}</b> expected. Tuesday holds
          {' '}<b>{weekdayData.record.count[2]}</b>. The busiest weekday is
          {' '}<b>{weekdayData.stat.recordSwing}</b> times the quietest; for ordinary reading on
          these same pages it is <b>{weekdayData.stat.readingSwing}</b> times.
        </p>

        <figure class="fig" id="weekday-fig">
          <div class="plate-box" id="weekday-plate" set:html={firstWeekday.svg}></div>
          <figcaption>
            The week runs left to right. Where the screen has room for it the same seven
            values are drawn more than once, so the rhythm reads as a wave. The thick curve is how many record days landed on each
            weekday, against how many of that weekday the eleven years hold. The thin curve is
            how much these same pages are read on each weekday in ordinary time, against their
            own average week. The line across the middle is where both curves would sit if
            every weekday were the same. The dots are the seven measured values; the curve
            between them is drawn, not measured.
          </figcaption>
        </figure>

        <details class="method">
          <summary>How this is measured</summary>
          <p>
            Expected counts come from how many of each weekday the window holds, which is
            {' '}{weekdayData.record.expect[1]} to {weekdayData.record.expect[4]} of each across
            {' '}{nf.format(weekdayData.meta.window.days)} days. A chi-square test on the seven
            counts gives <b>{weekdayData.record.chi2}</b> on {weekdayData.record.df} degrees of
            freedom, p = <b>{weekdayData.record.p}</b>.
          </p>
          <p>
            Ordinary reading is measured on the same pages long after their event, on days
            {' '}{weekdayData.meta.read[0]} to {weekdayData.meta.read[1]}. Each daily reading is
            divided by the median of the {weekdayData.meta.span} days centred on it, so however
            fast a page is rising or falling, only the day of the week is left. That is
            {' '}<b>{nf.format(weekdayData.reading.readings)}</b> readings across
            {' '}<b>{weekdayData.reading.pages}</b> pages, and the seven values are
            {' '}{weekdayData.reading.idx.map((v, i) => weekdayData.short[i] + ' ' + v.toFixed(3)).join(', ')}.
            Recomputing them over days {weekdayData.meta.alt[0]} to {weekdayData.meta.alt[1]}
            {' '}moves none of them by more than 0.01, and resampling whole pages
            {' '}{nf.format(weekdayData.meta.draws)} times puts the gap between the highest and
            the lowest weekday between <b>{weekdayData.reading.swingCI[0]}</b> and
            {' '}<b>{weekdayData.reading.swingCI[1]}</b>.
          </p>
          <p>
            The two weeks do not line up. Record days are highest on
            {' '}{weekdayData.stat.recordHigh} and lowest on {weekdayData.stat.recordLow};
            ordinary reading is highest on {weekdayData.stat.readingHigh} and lowest on
            {' '}{weekdayData.stat.readingLow}. Monday is a slightly busy reading day, by
            {' '}<b>4</b> percent, against a <b>66</b> percent excess in record days. Tuesday,
            the emptiest record day here, is an ordinary reading day at
            {' '}<b>{weekdayData.stat.tuesdayReading}</b>.
          </p>
          <p>
            Dates are UTC, as the source reports them, so an event that happens on a Sunday
            evening in the United States is recorded on the Monday. Nothing here explains why
            the counts fall this way, and nothing on this page claims a cause.
          </p>
        </details>

        <p class="src">{src}</p>
      </section>

      <section id="shared">
        <p class="num">07</p>
        <h2>When each record day happened, and the days more than one page shared</h2>
        <p class="deck">
          <b>{sharedData.stat.inBundles}</b> of the {sharedData.stat.all} record days are not
          one page having a day. They are two, three or four pages having the same day, on
          {' '}<b>{sharedData.stat.bundles}</b> dates. A model that keeps every record day in its
          own year, month and weekday expects <b>{sharedData.null.expected}</b>.
        </p>

        <figure class="fig" id="shared-fig">
          <div class="plate-box" id="shared-plate" set:html={firstShared.svg}></div>
          <div class="tip" id="shared-tip" hidden></div>
          <figcaption>
            Each dot is one page, placed left to right on the date of its record day and up the
            page by how many views that day drew. A ring drawn around a stack of dots means
            those pages all had their record day on the same date.
          </figcaption>
        </figure>

        <details class="method">
          <summary>How this is measured</summary>
          <p>
            Dates are lumpy on their own, and this file already knows its weekdays are uneven.
            So the count is tested against a model that holds each record day's year, month and
            weekday fixed and redraws only which matching day of that month it fell on. Over
            {' '}{nf.format(sharedData.null.draws)} draws that model puts
            {' '}<b>{sharedData.null.expected}</b> pages in a group on average, and reached
            {' '}{sharedData.stat.inBundles} or more <b>{sharedData.null.atLeastObserved}</b>
            {' '}times. p = <b>{sharedData.null.p.toExponential(1)}</b>.
          </p>
          <p>
            The {sharedData.stat.bundles} dates are {sharedData.stat.sizes['2']} pairs,
            {' '}{sharedData.stat.sizes['3']} threes and {sharedData.stat.sizes['4']} fours:
          </p>
          <ul class="roll">
            {sharedData.bundles.map((b) => (
              <li><i>{shortDate(b.d)}</i>{b.rows.map((r) => r.t).join(' · ')}</li>
            ))}
          </ul>
          <p>
            The vertical scale runs from {nf.format(sharedData.stat.minPeak)} to
            {' '}{nf.format(sharedData.stat.maxPeak)} views, which are the same smallest and
            largest record day the second section prints. Every step up it is a fixed multiple,
            not a fixed number of views.
          </p>
          <p>
            A page is in this file only if its own biggest day reached the daily top 1,000 for
            that day, so two pages sharing a date here means both were among the most-read pages
            on that date, not that nothing else happened.
          </p>
        </details>

        <p class="src">{src}</p>
      </section>

      <section id="return">
        <p class="num">08</p>
        <h2>How much traffic each page had on the day one year after its record day</h2>
        <p class="deck">
          On that one day, <b>{returnData.stat.above1}</b> of the {returnData.stat.n} pages that
          can be measured read above their own traffic level for the weeks around it. The middle
          page read <b>{returnData.stat.median}</b> times its own level. The same measurement
          taken at {returnData.meta.controls.slice(0, -1).join(', ')} and
          {' '}{returnData.meta.controls.at(-1)} days finds nothing.
        </p>

        <figure class="fig" id="return-fig">
          <div class="plate-box" id="return-plate" set:html={firstReturn.svg}></div>
          <figcaption>
            Each column is one page and each row is one day, from
            {' '}{returnData.meta.from} to {returnData.meta.to} days after that page's record day.
            A cell is coloured by how many times that day's traffic reads the page's own level
            for the weeks around the anniversary, and a day at or below that level is left pale.
            Columns are sorted by their reading on day {returnData.meta.day}, so the marked line
            is where the pages that read above their own level end.
          </figcaption>
        </figure>

        <details class="method">
          <summary>How this is measured</summary>
          <p>
            A page's level here is not the normal level used in the other sections. It is the
            median of days {returnData.meta.from} to {returnData.meta.to} after the record day
            with the fortnight either side of day {returnData.meta.day} taken out, so the day
            being measured cannot lift the level it is measured against. One page's reading is
            that day's views divided by that level, and every number in this section, including
            every control, comes out of that one calculation.
          </p>
          <p>
            <b>{returnData.stat.above2Pct}</b> percent of the pages read at least twice their own
            level on the day. Running the identical calculation at
            {' '}{returnData.controls.map((c) => c.d + ' days (' + c.median + ' times, ' + c.above2Pct + ' percent)').join(', ')}
            {' '}finds nothing of the kind. A sign test on
            {' '}{returnData.stat.above1} of {returnData.stat.n} gives p =
            {' '}<b>{returnData.stat.signP.toExponential(1)}</b>, and resampling the pages
            {' '}{nf.format(returnData.meta.draws)} times puts the middle value between
            {' '}<b>{returnData.stat.bootLo}</b> and <b>{returnData.stat.bootHi}</b>.
          </p>
          <p>
            <b>{returnData.stat.schedN}</b> of these pages are titled for something that happens
            again a year later, an election, a final, a ceremony, so their day
            {' '}{returnData.meta.day} may be the next one rather than a memory of the last. They
            read <b>{returnData.stat.schedMedian}</b> times. The other
            {' '}<b>{returnData.stat.otherN}</b> read <b>{returnData.stat.otherMedian}</b> times,
            with <b>{returnData.stat.otherAbovePct}</b> percent above their own level, so the
            finding does not rest on them. Dropping the four pages of the shape described in no
            section here and the eight renamed pages leaves
            {' '}{returnData.stat.cutN} pages at <b>{returnData.stat.cutMedian}</b> times.
          </p>
          <p>
            {returnData.stat.n} of the {returnData.stat.all} pages can be measured: the rest have
            a record day too recent for the file to hold a year after it.
            {' '}{returnData.stat.full} of the {returnData.stat.n} have every day of the window.
            The largest reading is {returnData.top[0].t} at <b>{returnData.top[0].text}</b> its
            own level, the smallest {returnData.low[0].t} at
            {' '}<b>{returnData.low[0].text}</b>. Traffic is still falling at day
            {' '}{returnData.meta.day} for some of these pages, which pulls the surrounding level
            up and the reading down, so this is the conservative direction.
          </p>
        </details>

        <p class="src">{src}</p>
      </section>

      <section id="window">
        <p class="num">09</p>
        <h2>How fast this traffic halves, measured over windows of different lengths</h2>
        <p class="deck">
          Fit a decay curve to the first {windowData.meta.short} days after the record day and it
          says traffic halves every <b>{windowData.stat.hlShort}</b> days. Fit the same curve to
          the same {windowData.stat.n} pages over {windowData.meta.long} days and it says
          {' '}<b>{windowData.stat.hlLong}</b>. Count the days the traffic actually takes and it
          is <b>{windowData.stat.obsLo}</b> to <b>{windowData.stat.obsHi}</b>.
        </p>

        <figure class="fig" id="window-fig">
          <div class="plate-box" id="window-plate" set:html={firstWindow.svg}></div>
          <figcaption>
            Left to right is how long a window the curve was fitted over. Up is the half-life
            that fit reports. The shaded band is the middle half of the
            {' '}{windowData.stat.n} pages and the line through it is the middle page. The flat
            band near the bottom is how long the traffic itself takes to halve, which is the same
            number however far out it is read.
          </figcaption>
        </figure>

        <details class="method">
          <summary>How this is measured</summary>
          <p>
            For each page, the traffic above its normal level is fitted twice over the same days:
            once against the day number, which is an exponential decay, and once against the
            logarithm of the day number, which is a power law. Only days above the page's own
            normal level can be used, and a page needs {windowData.meta.min} of them inside a
            window to be fitted there. <b>{windowData.stat.n}</b> pages clear that at both
            {' '}{windowData.meta.short} and {windowData.meta.long} days, and those same pages are
            what every point on this chart is measured on.
          </p>
          <p>
            The reason the answer moves is that the exponential is the wrong shape. Over
            {' '}{windowData.meta.short} days the power law fits better on
            {' '}<b>{windowData.stat.winShort}</b> of the {windowData.stat.n} pages
            {' '}({windowData.stat.winShortPct} percent, median R² {windowData.stat.r2ShortPow}
            {' '}against {windowData.stat.r2ShortExp}); over {windowData.meta.long} days, on
            {' '}<b>{windowData.stat.winLong}</b> ({windowData.stat.winLongPct} percent,
            {' '}{windowData.stat.r2LongPow} against {windowData.stat.r2LongExp}). A curve that is
            steep early and shallow late has no single halving time, so the number a fit reports
            is set by where the window stops.
          </p>
          <p>
            The pages of this file were selected partly on the shape of their fall, which if
            anything favours the exponential. So the same test was run on a second, separate set
            of <b>{windowData.probe.all}</b> events pulled by hand with no shape test of any kind:
            the power law fits better on <b>{windowData.probe.win}</b> of them,
            {' '}{windowData.probe.pct} percent, median R² {windowData.probe.r2pow} against
            {' '}{windowData.probe.r2exp}. That set counts all traffic rather than human readers
            only, so its numbers are not mixed with anything else on this page.
          </p>
          <p>
            The flat band is read without any model: the first day a page's traffic above normal
            falls to half, a tenth and a twentieth of the record day's, which is day
            {' '}{windowData.depths.map((d) => d.day).join(', day ')} for the middle page, and the
            half-life each of those implies —
            {' '}{windowData.depths.map((d) => d.hl + ' days').join(', ')}. Something that really
            decayed exponentially would give the same answer at all three depths, and this does.
            The fitted curve is above that band at every window on the chart, by a factor of
            {' '}<b>{windowData.stat.gap}</b> at the widest.
          </p>
        </details>

        <p class="src">{src}</p>
      </section>

      <section id="agree">
        <p class="num">10</p>
        <h2>How much traffic each page drew, next to the other pages whose record day was the same date</h2>
        <p class="deck">
          The census ranked <b>{agreeData.meta.ranked}</b> pages and a shape test kept
          {' '}<b>{agreeData.meta.kept}</b> of them. Put the <b>{agreeData.meta.cutRows}</b> it threw
          out back in and <b>{agreeData.stat.groups}</b> dates carry more than one page. One date
          carries <b>{agreeData.stat.n}</b>, and their record days are all within
          {' '}<b>{agreeData.stat.spreadPct}</b> per cent of each other.
        </p>

        <figure class="fig" id="agree-fig">
          <div class="plate-box" id="agree-plate" set:html={firstAgree.svg}></div>
          <div class="tip" id="agree-tip" hidden></div>
          <figcaption>
            Each row is one date. Each dot on it is one page, placed left or right by how its own
            record day compares with the middle record day of the pages it shares that date with, so
            a row whose pages drew the same traffic is a single mark on the centre line. A row is as
            tall as the number of pages on it. Dots in pink are pages the shape test threw out; dots
            in black are the {agreeData.meta.kept} pages drawn everywhere else on this page.
          </figcaption>
        </figure>

        <details class="method">
          <summary>How this is measured</summary>
          <p>
            On {shortDate(agreeData.meta.date)}, <b>{agreeData.stat.n}</b> pages each had the biggest
            traffic day in their history. Their record days run from
            {' '}{nf.format(agreeData.stat.lo)} to {nf.format(agreeData.stat.hi)} views — a largest
            over smallest of <b>{agreeData.stat.spread}</b>, a coefficient of variation of
            {' '}<b>{agreeData.stat.cv}</b> per cent, and {nf.format(agreeData.stat.total)} views
            between them. Every one of the {agreeData.stat.n} is a country or a historical state, and
            every one was thrown out by the shape test:
          </p>
          <p class="names">{agreeData.names.join(' · ')}</p>
          <p>
            <b>How many.</b> Dates are lumpy on their own, so the count is tested against the same
            model the seventh section uses: each page keeps its year, its month and its weekday, and
            only which matching day of that month it fell on is redrawn. Over
            {' '}{nf.format(agreeData.calendar.draws)} draws that model puts
            {' '}<b>{agreeData.calendar.expectRows}</b> pages on a shared date against the
            {' '}{agreeData.stat.inGroups} observed, and its biggest single date holds
            {' '}<b>{agreeData.calendar.expectMax}</b> pages on average and
            {' '}<b>{agreeData.calendar.everMax}</b> at its most extreme. It never reached
            {' '}{agreeData.stat.n}. p = <b>{agreeData.calendar.pMax.toExponential(1)}</b> for both.
          </p>
          <p>
            <b>How close.</b> Sharing a date is a coincidence; agreeing to a hundredth is not. Draw
            {' '}{agreeData.stat.n} pages at random from the same {agreeData.meta.ranked} and their
            record days spread a median <b>{agreeData.tight.median}</b> times; the tightest of
            {' '}{nf.format(agreeData.tight.draws)} draws is <b>{agreeData.tight.best}</b>, and none
            reached {agreeData.stat.spread}. The file's peaks also crowd towards the bottom of the
            ranking, so the same question was asked without any null at all: the tightest
            {' '}{agreeData.stat.n} record days that can be assembled from anywhere else in the
            {' '}{agreeData.meta.ranked} spread <b>{agreeData.stat.packed}</b> times, and they sit on
            {' '}{agreeData.stat.n} different dates.
          </p>
          <p>
            The research record for this project claimed every other multi-page date spreads at least
            1.14 times, median 2.24. Both numbers were wrong and are corrected here.
            {' '}<b>{agreeData.stat.minSpread3}</b> is the tightest other date carrying three or more
            pages ({shortDate(agreeData.stat.runnerUp)}); three pairs are tighter than
            {' '}{shortDate(agreeData.meta.date)} is, which is what pairs do when there are 33 of
            them. The median over the other {agreeData.stat.groups - 1} dates is
            {' '}<b>{agreeData.stat.medSpreadOthers}</b>, and the
            {' '}{agreeData.stat.siteGroups} shared dates the seventh section draws spread a median
            {' '}{agreeData.stat.medSpreadSite}.
          </p>
          <p>
            A second reading agrees and does not look at size at all. The shape test records each
            page's traffic on day seven against day three. <b>{agreeData.stat.fellRows}</b> of the
            {' '}{agreeData.meta.ranked} pages are at {agreeData.meta.fallAt} of day three or less by
            day seven, and <b>{agreeData.stat.fellHere}</b> of those {agreeData.stat.fellRows} are
            this one date. So the {agreeData.stat.n} pages are not only the same size, they are the
            same shape.
          </p>
          <p>
            The other date whose pages agree is {shortDate('2018-01-18')}: JSON Web Token, HTTP
            cookie, Access token and Session token, within
            {' '}{Math.round((agreeData.groups.find((g) => g.d === '2018-01-18').spread - 1) * 100)}
            {' '}per cent of each other, all four thrown out.
          </p>
          <p>
            The limits. <b>{agreeData.stat.bandRows}</b> pages anywhere in the
            {' '}{agreeData.meta.ranked} fall inside the value band these {agreeData.stat.n} occupy,
            so {agreeData.stat.bandRows - agreeData.stat.bandHere} pages on other dates are that size
            too; the band is busy, not empty. A thrown-out page has a peak, a date and three test
            readings in the source file and no traffic history at all, so no page drawn in pink here
            can appear on any chart on this page whose axis is days. And what produced this is not
            identifiable from this extract: a crawler, a mirror and a redirect all leave the same
            marks.
          </p>
          <p>
            All {agreeData.stat.groups} dates, with the number of pages on each and how far apart
            they are:
          </p>
          <ul class="roll">
            {agreeData.groups.map((g) => (
              <li><i>{shortDate(g.d)}</i>{g.n} pages, {g.spread === 1 ? 'identical' : 'within ' + Math.round((g.spread - 1) * 100) + '%'}{g.cut ? ' · ' + g.cut + ' thrown out' : ''}</li>
            ))}
          </ul>
        </details>

        <p class="src">{src}</p>
      </section>

      <section id="stop">
        <p class="num">11</p>
        <h2>How each page's traffic fell over the sixty days after its record day</h2>
        <p class="deck">
          Across <b>{stopData.stat.tested}</b> pages, the last day still being read at event scale
          draws <b>{stopData.stat.median}</b> times the day after it. Four pages hold a flat top for
          days and then fall <b>{stopData.snaps[0].snap}</b>, <b>{stopData.snaps[1].snap}</b> and
          {' '}<b>{stopData.snaps[2].snap}</b> times overnight. The next largest in the file is
          {' '}<b>{stopData.stat.nextDownSnap}</b>.
        </p>

        <figure class="fig" id="stop-fig">
          <div class="plate-box" id="stop-plate" set:html={firstStop.svg}></div>
          <figcaption>
            Each line is one page. Left to right is the first {stopData.meta.days} days after its
            record day; up is how many times that page's own normal traffic level it was reading that
            day, so pages that drew 1.4 million and 15 million views sit on one scale. A line's
            colour is that page's own return time, the same colour scale the first chart uses. The
            four drawn dark and heavy stop dead: each is labelled with the day it stopped and, on a
            wide screen, how many times its traffic fell overnight.
          </figcaption>
        </figure>

        <details class="method">
          <summary>How this is measured</summary>
          <p>
            <b>The snap.</b> Take the last day a page was still being read at event scale — above
            {' '}{stopData.meta.scale} times its own normal level and at least
            {' '}{nf.format(stopData.meta.floor)} views — and divide it by the day after. Attention
            that is real is still coming down, so that ratio is small: over
            {' '}<b>{stopData.stat.tested}</b> pages the middle value is
            {' '}<b>{stopData.stat.median}</b>, three quarters are under {stopData.stat.p75} and nine
            tenths under {stopData.stat.p90}. Three pages are at
            {' '}<b>{stopData.snaps[0].snap}</b>, <b>{stopData.snaps[1].snap}</b> and
            {' '}<b>{stopData.snaps[2].snap}</b>, and the fourth largest anywhere in the file is
            {' '}{stopData.stat.nextDown} at {stopData.stat.nextDownSnap}.
          </p>
          <p>
            <b>The dropout.</b> A separate reading that never looks at the end of an event: a single
            day at least {stopData.meta.deep} times below both the day before it and the day after
            it, where both of those are above {nf.format(stopData.meta.neigh)} views. An audience
            cannot vanish and return overnight. Exactly {stopData.drops.length} pages in the file
            have such a day — {stopData.drops.map((d) => d.t + ' (' + d.days.length + ')').join(', ')}
            {' '}— and nobody else has one.
          </p>
          <p>
            The two readings name <b>{stopData.stat.named}</b> pages between them and agree on
            {' '}{stopData.stat.both}. {stopData.story['Index_(statistics)'].t} sat at
            {' '}{stopData.story['Index_(statistics)'].base} views a day, held
            {' '}<b>{stopData.story['Index_(statistics)'].run.days}</b> straight days at event scale
            running {nf.format(stopData.story['Index_(statistics)'].run.lo)} to
            {' '}{nf.format(stopData.story['Index_(statistics)'].run.hi)}, and read
            {' '}<b>{stopData.story['Index_(statistics)'].snapTo}</b> the next day.
            {' '}{stopData.story["Cook's_Country"].t} sat at
            {' '}{stopData.story["Cook's_Country"].base} views a day, read 57 two days before its
            record day and 833,826 one day before it, and
            {' '}{stopData.story["Cook's_Country"].snapTo} on day
            {' '}{stopData.story["Cook's_Country"].snapDay + 1}.
            {' '}{stopData.story['Question_mark'].t} read 522,905 on day one,
            {' '}<b>1,142</b> on day two and 638,607 on day three.
          </p>
          <p>
            {stopData.story['Dulce_María'].t} is named by the dropout reading and not by the snap,
            and the reason is worth stating: her traffic is still above
            {' '}{stopData.meta.scale} times her own normal level on day 400, the last day this file
            covers, so there is no day after to divide by. She is one of
            {' '}{stopData.stat.stillRunning} pages in that position; {stopData.stat.noScale} more
            never reach event scale at all, which is why the snap is read on
            {' '}{stopData.stat.tested} pages rather than {stopData.stat.drawn}. Her four dropout
            days are {stopData.drops[0].days.join(', ')}, past the right edge of this chart. What the
            chart points at instead is her steepest single day inside it: day
            {' '}<b>{stopData.story['Dulce_María'].fallDay}</b>, from
            {' '}{nf.format(stopData.story['Dulce_María'].fallFrom)} views to
            {' '}{nf.format(stopData.story['Dulce_María'].fallTo)}.
          </p>
          <p>
            The same reading applied to the other three points at the same day the snap does for
            two of them and not for {stopData.story['Question_mark'].t}, whose steepest day inside
            this window is its dropout on day {stopData.story['Question_mark'].fallDay + 1} —
            {' '}<b>{stopData.story['Question_mark'].fallBy}</b> times in one day, larger than the
            {' '}{stopData.story['Question_mark'].snap} it falls when it finally stops on day
            {' '}{stopData.story['Question_mark'].snapDay}. The two readings disagree about which of
            its days matters most, which is why both are kept.
          </p>
          <p>
            These four are in every other chart on this page and move none of them. The middle
            return time is <b>{stopData.contam.durMedian}</b> days with them and
            {' '}<b>{stopData.contam.durMedianNo}</b> without. The share of pages settling above
            their own normal level is <b>{stopData.contam.settleAbove}</b> per cent with them and
            {' '}<b>{stopData.contam.settleAboveNo}</b> without.
          </p>
          <p>
            <b>What caused this is not identifiable from this extract</b> and nothing here names a
            cause. An automated crawl, a mirror and a redirect pointed at a title all draw the same
            rectangle in a pageview file, and nothing in the census separates them. What is reported
            is the shape, which two unrelated readings agree on and which no readership in the file
            has.
          </p>
          <p>
            {stopData.stat.drawn} of the {stopData.stat.all} pages are drawn. The other
            {' '}{stopData.stat.all - stopData.stat.drawn} have no quiet month before their record
            day to measure a normal level against, which is the same six the first chart leaves out.
            Two pages have days the source never returned and are drawn as broken lines. A page
            reading below its own normal level is drawn on the bottom line rather than under it,
            so the floor of this chart is a floor and not a reading.
          </p>
        </details>

        <p class="src">{src}</p>
      </section>
    </main>

    <DcdMark />

    <style define:vars={{ accent: ACCENT, ink: INK, muted: MUTED, hair: HAIR }}>
