---
// The Cast — the whole site. One page, four sheets, then the method.
//
// The page is a walk, not an essay: a finding as the heading, the sheet that shows it,
// and at most one line under it. Everything that is method rather than finding lives in
// the tail, once, so no beat has to carry it.
//
// Every figure is read out of data/census/cast.json, which scripts/analyse-cast.js writes
// from src/lib/findings.js, or out of the census file's own meta block. Nothing here is
// typed by hand, and test/copy.test.js fails the build if a number appears that neither
// file can account for.
import cast from '../../data/census/cast.json'
import census from '../../data/census/top-days.json'
import renamed from '../../data/census/renamed.json'
import DcdMark from '../components/DcdMark.astro'
import { heroSvg } from '../lib/marks/hero.js'
import { fameSvg } from '../lib/marks/fame.js'
import { backSvg } from '../lib/marks/back.js'
import { lagSvg } from '../lib/marks/lag.js'
import { SOURCE } from '../lib/marks/lib.js'
import { SITE } from '../lib/site.js'
import '../styles/site.css'

const c = cast
const meta = census.meta
const q = meta.qualify
const num = (n) => n.toLocaleString('en-US')

// The widths the server draws at. A reader with script gets these redrawn at the width
// their box actually has, before the first paint they can see.
const WIDE = 1180
const HALF = 560

const hero = heroSvg(c, WIDE)
const fame = fameSvg(c, HALF)
const back = backSvg(c, WIDE)
const lag = lagSvg(c, WIDE)

const measured = c.constellations.filter((k) => k.median !== null)
const inside = measured.filter((k) => k.median <= c.bond.p95).length
const underFloor = c.fame.cast.underFloor + c.fame.solo.underFloor
const floorRow = c.constellations.find((k) => k.date === '2018-08-16')
const brady = c.constellations.find((k) => k.date === '2021-02-08')
const machine = c.machine.found[0]
// What the correlation is in readers: take the days on which one page was read most
// unusually and read its castmate on exactly those days. The largest edge and the
// smallest, so the line carries its own counter-example.
const edges = c.constellations.flatMap((k) => k.edges)
const lifts = edges.slice().sort((a, b) => b.lift - a.lift)
const flat = edges.slice().sort((a, b) => a.lift - b.lift)[0]
const topShare = Math.round(c.definitions.topShare * 100)
const nameOf = (a) => a.replace(/_/g, ' ')

const title = 'The cast'
const desc = `${c.groups.inCast} of the ${c.groups.total} biggest days in Wikipedia's reading record are shared by ` +
  `two, three or four pages at once. A year later those pages were still moving together.`
const og = new URL('/og/cast.png', Astro.site ?? SITE).href
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={desc} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:image" content={og} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={desc} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/archivo-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/archivo-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin />
  </head>

  <body>
    <header class="masthead shell">
      <h1>{title}</h1>
      <p class="dek">
        {c.groups.inCast} of the {c.groups.total} biggest reading days in Wikipedia's record are not one page
        having a day. They are two, three or four pages having the same day, in {c.groups.casts} groups.
      </p>
    </header>

    <section id="cast" class="shell">
      <h2>A year later, they were still moving together</h2>
      <figure class="mark">
        <div class="mark-box" data-draw="hero" set:html={hero.svg}></div>
      </figure>
      <p class="beat">
        Half the pairs that shared a record day sit at {c.bond.same.median}. Pairs that shared no date sit at
        {' '}{c.bond.far.median}.
      </p>
    </section>

    <hr class="rule" />

    <section id="fame" class="shell">
      <h2>One page was already famous. The other was not.</h2>
      <div class="pair">
        {fame.map((p) => (
          <figure class="mark">
            <div class="mark-box" data-draw="fame" set:html={p.svg}></div>
          </figure>
        ))}
      </div>
      <p class="beat">
        The record days are the same size, {c.fame.peakGap}% apart. The page that shared its day multiplied
        itself {c.fame.cast.lift} times over. The page that had it alone, {c.fame.solo.lift} times.
      </p>
    </section>

    <hr class="rule" />

    <section id="back" class="shell">
      <h2>They come back down together</h2>
      <figure class="mark">
        <div class="mark-box" data-draw="back" set:html={back.svg}></div>
      </figure>
      <p class="beat">No correlation here and no detrending, only the day each page stopped being unusual.</p>
    </section>

    <hr class="rule" />

    <section id="lag" class="shell">
      <h2>Move one calendar by a day and it goes</h2>
      <figure class="mark">
        <div class="mark-box" data-draw="lag" set:html={lag.svg}></div>
      </figure>
      <p class="beat">
        In readers: take the {topShare}% of days a page was read most unusually, then read its castmate on
        exactly those days. {nameOf(lifts[0].a)}'s days put {nameOf(lifts[0].b)} at {lifts[0].lift} times her
        own ordinary amount. {nameOf(flat.a)}'s put {nameOf(flat.b)} at {flat.lift}.
      </p>
    </section>

    <hr class="rule" />

    <section id="method" class="shell">
      <details class="how">
      <summary>How the file was built</summary>
      <div class="method">
        <div>
          <h3>The set</h3>
          <p>
            Every article that ever reached a day's most-read list over {num(meta.window.days)} days:
            {' '}{num(meta.articles_seen)} of them. The {num(meta.candidates_tested)} largest single days were
            pulled in full, {meta.qualified} passed the gate, and the {c.groups.total} largest are this file.
          </p>
        </div>
        <div>
          <h3>The gate</h3>
          <p>
            A row qualifies only if, {q.at} days after its peak, it still holds {q.alive} of that peak; it
            holds {q.share} of the peak or sits at {q.lift} times its own level before the event; and it has
            fallen under {q.falling} of where it was {q.against} days after. Nothing in it looks at where a
            page settles a year later, which is the thing measured here.
          </p>
        </div>
        <div>
          <h3>The tie</h3>
          <p>
            The correlation of two pages' daily readings over days {c.definitions.from} to {c.definitions.to}
            after each peak, after a rolling median of the {c.definitions.half} days either side of a day is
            subtracted from it, matched on calendar date and requiring {c.definitions.sharedMin} dates both
            pages were read on. {c.bond.rows} of the {c.groups.total} pages carry a long enough series.
          </p>
        </div>
        <div>
          <h3>What the first sheet draws</h3>
          <p>
            Each cell draws that same residual, one day at a time, its largest page above the line and its
            second below. For drawing only, a day is clipped at {c.tracks.clip} either side of nought, which
            touches {c.tracks.clippedShare}% of the {num(c.tracks.readings)} readings on the sheet.
          </p>
        </div>
        <div>
          <h3>The null</h3>
          <p>
            Redrawing every record date inside its own year, its own month and its own weekday
            {' '}{num(c.groups.null.draws)} times puts {c.groups.null.expected} rows in a group rather than
            {' '}{c.groups.inCast}. No draw of the {num(c.groups.null.draws)} reached {c.groups.inCast}, and
            none reached the observed median tie. Permuting which pairs count as same-day
            {' '}{num(c.back.permutation.draws)} times, no draw came down as close as {c.back.same.median}
            {' '}days.
          </p>
        </div>
        <div>
          <h3>The groups that do not separate</h3>
          <p>
            {inside} of the {measured.length} measurable groups sit inside the middle {c.bond.band}% of the
            pairs that shared no date, {c.bond.p05} to {c.bond.p95}. Aretha Franklin and Atal Bihari Vajpayee
            sit at {floorRow.median}, Tom Brady and The Weeknd at {brady.median}. {c.bond.aboveP95} of the
            {' '}{c.bond.same.n} same-day pairs sit above that band.
          </p>
        </div>
        <div>
          <h3>Shared words, and the near miss</h3>
          <p>
            {c.bond.same.n - c.bond.tokens.kept} of the {c.bond.same.n} same-day pairs share a word between
            their titles; dropping every one leaves {c.bond.tokens.kept} pairs at {c.bond.tokens.median}.
            Pairs whose record days fell 1 to {c.definitions.near} days apart, the same news season, sit at
            {' '}{c.bond.near.median} over {c.bond.near.n} pairs. By quarter after the peak the tie weakens
            and does not fall into the noise:
            {' '}{c.bond.quarters.map((qq) => `${qq.same.median} against ${qq.far.median}`).join(', ')}.
          </p>
        </div>
        <div>
          <h3>The {c.fame.floor}-readers-a-day floor</h3>
          <p>
            A page read fewer than {c.fame.floor} times a day before its event has no level for a multiple to
            be taken against. {underFloor} of the {c.groups.total} sit under it. They are drawn on the left
            edge of the readers-before panel and left out of both multiples and of the test. Mann-Whitney
            with a tie correction, two-sided: z {c.fame.test.z}, p rounds to {c.fame.test.p.toFixed(3)}, on
            {' '}{c.fame.test.n1} and {c.fame.test.n2} pages.
          </p>
        </div>
        <div>
          <h3>The {c.bond.dropped.renamed} renamed titles</h3>
          <p>
            {c.bond.dropped.renamed} of the {c.groups.total} articles were later moved to a new title. The old
            title stops receiving traffic at the move, so a series read after it measures the move. They are
            kept in every figure about the record day itself and dropped from every figure about the year
            after.
          </p>
          <ul class="renamed">
            {Object.entries(renamed).map(([from, to]) => (
              <li><b>{from.replace(/_/g, ' ')}</b> is now {to}</li>
            ))}
          </ul>
        </div>
        <div>
          <h3>The machine test</h3>
          <p>
            A crawl can pass the gate and still show a shape no readership has: one day back at its own level
            with a day either side a hundred times above it. The rule looks for a day at or under
            {' '}{c.definitions.machine.at} times a page's own level between two days at or over
            {' '}{c.definitions.machine.around} times it, within {Math.abs(c.definitions.machine.from)} days
            of the peak. Exactly {c.machine.n} of {c.groups.total} qualifies:
            {' '}{machine.article.replace(/_/g, ' ')}, record day {machine.date}, reading
            {' '}{num(machine.value)} on day {machine.day} between {num(machine.before)} and
            {' '}{num(machine.after)}, on a level of {num(machine.base)}. It is dropped from every figure
            about the aftermath. It had its record day alone, so {c.groups.inCast} of {c.groups.total} is
            unmoved; the one figure that moves is the median of the pairs that shared no date, from
            {' '}{c.bond.withMachine.far.median} to {c.bond.far.median}.
          </p>
        </div>
        <div>
          <h3>Missing is not zero</h3>
          <p>
            A page with no pre-event level to come back to, and a page whose title was renamed, carry no day
            and are left out of their row rather than counted as a zero. Two groups have no measurable tie at
            all; they are named on the first sheet rather than dropped from it.
          </p>
        </div>
        <div>
          <h3>Users, not agents</h3>
          <p>
            Every count here is the user-agent series. A separate probe counts all agents and reads larger for
            the same peak. The two are never mixed inside one figure.
          </p>
        </div>
      </div>
      <p class="colophon">
        {SOURCE} Window {meta.window.start} to {meta.window.end}. Data licensed CC0 by the Wikimedia
        Foundation. Every figure on this page is computed by <code>src/lib/findings.js</code> and written to
        {' '}<code>data/census/cast.json</code>; the page reads that file and states nothing it does not
        contain.
      </p>
      </details>
    </section>

    <footer>
      <DcdMark />
    </footer>

    <script>
      import '../scripts/marks.js'
    </script>
  </body>
</html>
