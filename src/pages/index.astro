---
/**
 * One page. The theme sentence this is built from:
 *
 *   "Every mark is one page measured against its own quiet, laid on one axis of days since
 *    the day. This is a stopwatch, not a front page."
 *
 * COPY RULE, set by Dustin 2026-08-31 and binding on every heading, caption and title on
 * this site: say plainly what the reader is looking at. A heading names the measurement;
 * a caption says what one mark is. The numbers carry the interest, not the wording.
 *
 * Six sections, from eleven. What was cut was every section that explained a method rather
 * than showed a measurement, and every section that rested on the one-year idea. The
 * method now lives in one folded block at the foot of the page.
 */
import plate from '../gen/plate.json'
import arrivalData from '../gen/arrival.json'
import settleData from '../gen/settle.json'
import weekdayData from '../gen/weekday.json'
import sharedData from '../gen/shared.json'
import eventsData from '../gen/events.json'
import pagesData from '../gen/pages.json'
import { field } from '../lib/marks/field.js'
import { leap } from '../lib/marks/leap.js'
import { settled } from '../lib/marks/settled.js'
import { weekdays } from '../lib/marks/weekdays.js'
import { timeline } from '../lib/marks/timeline.js'
import { trace } from '../lib/marks/trace.js'
import { HEX, ACCENT, INK, MUTED, HAIR, ink } from '../lib/ink.js'
import { shortDate, nf } from '../lib/marks/util.js'
import DcdMark from '../components/DcdMark.astro'
import { SITE } from '../lib/site.js'

const firstField = field(plate, 1180)
const firstLeap = leap(arrivalData, 1180)
const firstSettled = settled(settleData, 1180)
const firstWeekdays = weekdays(weekdayData, 1180)
const firstTimeline = timeline(sharedData, 1180)

// The page the panel opens on: the biggest record day in the file.
const firstPage = pagesData.rows.reduce((m, r) => (r.peak > m.peak ? r : m), pagesData.rows[0])
const firstTrace = trace(firstPage, plate.stops, pagesData.meta.days, 720)

// The closing wall: every page, shortest stay first.
const kindBy = new Map(plate.rows.map((r) => [r.a, r]))
const ORDER = { back: 0, holdout: 1, running: 2, none: 3 }
const wall = eventsData.events
  .map((e) => { const p = kindBy.get(e.a); return { t: e.t, kind: p ? p.kind : 'none', dur: p ? p.dur : null } })
  .sort((a, b) => ORDER[a.kind] - ORDER[b.kind] || (a.kind === 'back' ? a.dur - b.dur : 0) || a.t.localeCompare(b.t))
const wallFig = (w) => w.kind === 'back' ? String(w.dur) : w.kind === 'holdout' ? 'never' : w.kind === 'running' ? 'not yet' : 'unmeasured'
const wallInk = (w) => w.kind === 'back' ? ink(w.dur, plate.stops) : w.kind === 'none' ? MUTED : HEX[4]
const rampCss = `linear-gradient(90deg, ${plate.stops.map((s, i) => `${HEX[i]} ${((s / plate.stat.max) * 100).toFixed(1)}%`).join(', ')})`

const w = plate.meta.window
const src = `Wikimedia daily pageviews, en.wikipedia, all-access, user agents only. ${w.start} to ${w.end}. Public domain, CC0.`
const never = plate.stat.holdout + plate.stat.running

const NAME = 'Record Days'
const TITLE = `${NAME} — the biggest traffic day of ${plate.stat.all} Wikipedia pages`
const DESC = `${plate.stat.all} English Wikipedia pages, each shown on the single biggest traffic ` +
  `day it has ever had, and how long its traffic stayed high afterwards. Of the ${plate.stat.back} ` +
  `that came back to their normal level, the middle one took ${plate.stat.median} days. ` +
  `${never} never came back.`
const CARD = `${SITE}/og.png`
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{TITLE}</title>
    <meta name="description" content={DESC} />
    <link rel="canonical" href={SITE} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={NAME} />
    <meta property="og:url" content={SITE} />
    <meta property="og:title" content={TITLE} />
    <meta property="og:description" content={DESC} />
    <meta property="og:image" content={CARD} />
    <meta property="og:image:width" content="2400" />
    <meta property="og:image:height" content="1260" />
    <meta property="og:image:alt" content={`Bar chart. ${plate.stat.drawn} Wikipedia pages, one bar each, sorted shortest to longest, showing how many days each took to return to its normal traffic level after its record day.`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={TITLE} />
    <meta name="twitter:description" content={DESC} />
    <meta name="twitter:image" content={CARD} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/martian-mono-var-latin.woff2" />
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/schibsted-grotesk-var-latin.woff2" />
  </head>

  <body>
    <div class="progress" aria-hidden="true"><i id="progress-bar"></i></div>

    <header class="head wrap">
      <h1>{NAME}</h1>
      <p class="stand">
        <b>{plate.stat.all}</b> English Wikipedia pages, each on the single biggest traffic day
        it has ever had. Those days drew between <b>{(plate.stat.minPeak / 1e6).toFixed(1)}</b> and
        {' '}<b>{(plate.stat.maxPeak / 1e6).toFixed(1)}</b> million views, between {plate.stat.from} and {plate.stat.to}.
      </p>
    </header>

    <main class="wrap">
      <section id="field">
        <h2>How many days each page's traffic stayed high after its record day</h2>

        <div class="clock" id="clock">
          <p class="clock-day"><span>Day</span> <b id="clock-d">{plate.stat.max}</b></p>
          <p class="clock-line" id="clock-line"><b>{plate.stat.back}</b> pages back to normal · <b>{never}</b> never returned</p>
          <button type="button" class="replay" id="replay">Replay from day 0</button>
          <input class="sr-only" type="range" id="clock-range" aria-label="Days since the record day" min="0" max={plate.stat.max} value={plate.stat.max} step="1" />
        </div>

        <figure class="fig" id="field-fig">
          <div class="plate-box" id="field-plate" set:html={firstField.svg}></div>
          <div class="tip" id="field-tip" hidden></div>
          <figcaption>
            Each bar is one page, sorted shortest to longest. It runs from the record day to the day
            the page's traffic fell back under twice its normal level and stayed there for a week.
            A bar's colour repeats its length, so the axis is also the key. Drag the marker along the
            axis to move through the days.
          </figcaption>
        </figure>
      </section>

      <section id="leap">
        <h2>How much traffic each page had the day before its record day</h2>
        <p class="deck">
          Half of the pages had under <b>{nf.format(Math.round(arrivalData.stat.medianBefore))}</b> views the
          day before. <b>{arrivalData.stat.under1000}</b> had under <b>1,000</b>.
          {' '}{arrivalData.pope.t}'s page had <b>{arrivalData.pope.before}</b>.
        </p>
        <figure class="fig" id="leap-fig">
          <div class="plate-box" id="leap-plate" data-reveal="leap" set:html={firstLeap.svg}></div>
          <div class="tip" id="leap-tip" hidden></div>
          <figcaption>
            Each line is one page, from its views the day before (bottom) up to its views on the
            record day (top). Each step along the scale is ten times the last.
          </figcaption>
        </figure>
      </section>

      <section id="settled">
        <h2>Where each page's traffic settled 300 to 340 days after its record day</h2>
        <p class="deck">
          <b>{settleData.stat.n}</b> of the {settleData.stat.all} pages can be measured this far out.
          {' '}<b>{settleData.stat.above}</b> were still getting more traffic than before their record day.
          {' '}<b>{settleData.stat.below}</b> were getting less.
        </p>
        <figure class="fig" id="settled-fig">
          <div class="plate-box" id="settled-plate" data-reveal="settled" set:html={firstSettled.svg}></div>
          <div class="tip" id="settled-tip" hidden></div>
          <figcaption>
            Each square is one page, placed by its daily traffic 300 to 340 days after the record day
            as a multiple of its normal level before it. Hollow squares are pages renamed during that
            year, so the old title stopped receiving traffic.
          </figcaption>
        </figure>
      </section>

      <section id="weekdays">
        <h2>Which day of the week the record days landed on</h2>
        <p class="deck">
          Monday holds <b>{weekdayData.record.count[1]}</b> of the {weekdayData.stat.n} record days.
          Spread evenly, each weekday would hold about <b>{Math.round(weekdayData.record.expect[0])}</b>.
          Tuesday holds <b>{weekdayData.record.count[2]}</b>.
        </p>
        <figure class="fig" id="weekdays-fig">
          <div class="plate-box" id="weekdays-plate" data-reveal="weekdays" set:html={firstWeekdays.svg}></div>
          <figcaption>Dates are UTC, as the source reports them.</figcaption>
        </figure>
      </section>

      <section id="timeline">
        <h2>When each record day happened</h2>
        <p class="deck">
          <b>{sharedData.stat.inBundles}</b> of the {sharedData.stat.all} record days share their date
          with another page on this list, on <b>{sharedData.stat.bundles}</b> dates. Select a dot to see
          that page's own traffic.
        </p>
        <div class="tl">
          <figure class="fig" id="timeline-fig">
            <div class="plate-box" id="timeline-plate" data-reveal="timeline" set:html={firstTimeline.svg}></div>
            <div class="tip" id="timeline-tip" hidden></div>
            <figcaption>
              Each dot is one page, placed by the date of its record day and the views it drew that day.
              A ring groups pages whose record day is the same date.
            </figcaption>
          </figure>

          <div class="page" id="page" aria-live="polite">
            <p class="page-name" id="page-name">{firstPage.t}</p>
            <p class="page-facts" id="page-facts">
              <span>Record day <b>{shortDate(firstPage.d)}</b></span>
              <span><b>{nf.format(firstPage.peak)}</b> views that day</span>
              <span><b>{nf.format(firstPage.before)}</b> the day before</span>
              <span>Back to normal on day <b>{firstPage.dur}</b></span>
            </p>
            <div class="plate-box" id="page-plate" set:html={firstTrace.svg}></div>
          </div>
        </div>
      </section>

      <section id="all">
        <h2>All {plate.stat.all} pages, sorted by how long their traffic stayed high</h2>
        <p class="deck">The number after each name is the days until its traffic was back to normal.</p>
        <ul class="wall" id="wall">
          {wall.map((e) => (
            <li class="e"><span>{e.t}</span><b style={`color:${wallInk(e)}`}>{wallFig(e)}</b></li>
          ))}
        </ul>
        <div class="key">
          <div class="key-ramp" style={`background:${rampCss}`}></div>
          <div class="key-ends"><span>{plate.stat.min} day</span><span>{plate.stat.median} days</span><span>{plate.stat.max} days</span></div>
          <p class="key-notes">
            <span><i style={`background:${HEX[4]}`}></i><b>never</b> still above twice normal a full year later, {plate.stat.holdout} pages</span>
            <span><i style={`background:${HEX[4]}`}></i><b>not yet</b> record day too recent to tell, {plate.stat.running} pages</span>
            <span><i style={`background:${MUTED}`}></i><b>unmeasured</b> no normal level in the month before, {plate.stat.noQuiet} pages</span>
          </p>
        </div>

        <details class="method">
          <summary>How this is measured</summary>
          <p>
            <b>The pages.</b> Every English Wikipedia article's single biggest day in the daily top 1,000,
            {' '}{w.start} to {w.end}, ranked by views. The {plate.stat.all} kept are the largest that also
            rose and then fell within a week, so bigger single days exist that this rule excluded. This is
            each page's own biggest day, not a list of the biggest days on Wikipedia.
          </p>
          <p>
            <b>Normal level.</b> The median of a page's daily views from {Math.abs(plate.meta.before[0])} to
            {' '}{Math.abs(plate.meta.before[1])} days before its record day. One definition, used in every
            section. {plate.stat.noQuiet} pages have no such level because their traffic was already high
            all month, and they are left out of the first chart.
          </p>
          <p>
            <b>Back to normal.</b> The first day a page's traffic is under twice its normal level and stays
            there for seven days. {plate.stat.holdout} pages were tracked for a full year and never got
            there. {plate.stat.running} have a record day too recent for the file to say.
          </p>
          <p>
            <b>Scheduled events.</b> A tournament or ceremony runs longer than a month, so the window used
            for its normal level sits inside the event. The FIFA World Cup, WrestleMania and Academy Awards
            bars are shorter than they should be for that reason.
          </p>
          <p>
            <b>Views, not people.</b> The source counts pageviews by users and does not identify readers.
            One person loading a page ten times counts ten times.
          </p>
        </details>

        <p class="src">{src}</p>
      </section>
    </main>

    <DcdMark />

    <style define:vars={{ accent: ACCENT, ink: INK, muted: MUTED, hair: HAIR }}>
      :root { color-scheme: light; }
      html { -webkit-text-size-adjust: 100%; }
      body {
        margin: 0;
        background: #fff;
        color: var(--ink);
        font-family: 'Schibsted Grotesk', -apple-system, 'Segoe UI', Helvetica, Arial, sans-serif;
        font-size: 16px;
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
      }
      .wrap { max-width: 1240px; margin: 0 auto; padding: 0 24px; }

      .progress { position: fixed; top: 0; left: 0; right: 0; height: 3px; z-index: 4; pointer-events: none; }
      .progress i {
        display: block; height: 100%; transform-origin: 0 50%; transform: scaleX(0);
        background: linear-gradient(90deg, #1E2170, #5B2A93 20%, #B31E63 45%, #C9452C 70%, #C67F08);
      }

      .head { padding-top: 60px; }
      h1 {
        font-family: 'Martian Mono', ui-monospace, monospace;
        font-weight: 600; font-size: 40px; letter-spacing: -0.03em; line-height: 1.1;
        margin: 0;
      }
      .stand { margin: 14px 0 0; max-width: 58ch; color: var(--muted); font-size: 17px; text-wrap: pretty; }
      .stand b, .deck b, .page-facts b, .method b, .key-notes b { color: var(--ink); font-weight: 500; }
      .stand b, .deck b, .page-facts b { font-family: 'Martian Mono', ui-monospace, monospace; font-size: 0.9em; }

      section { padding: 96px 0 0; }
      section#field { padding-top: 44px; }
      h2 { font-size: 30px; font-weight: 500; letter-spacing: -0.02em; line-height: 1.2; margin: 0; max-width: 34ch; text-wrap: balance; }
      .deck { margin: 12px 0 0; max-width: 58ch; color: var(--muted); font-size: 17px; text-wrap: pretty; }

      .fig { margin: 28px 0 0; position: relative; }
      .plate-box { width: 100%; }
      figcaption { margin: 16px 0 0; max-width: 66ch; color: var(--muted); font-size: 14px; line-height: 1.45; text-wrap: pretty; }

      /* the stopwatch readout */
      .clock { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 22px; margin: 22px 0 0; }
      .clock p { margin: 0; }
      .clock-day { font-family: 'Martian Mono', ui-monospace, monospace; color: var(--ink); font-size: 16px; }
      .clock-day b { font-size: 40px; font-weight: 600; letter-spacing: -0.03em; font-variant-numeric: tabular-nums; display: inline-block; min-width: 3ch; }
      .clock-line { color: var(--muted); font-size: 17px; }
      .clock-line b { font-family: 'Martian Mono', ui-monospace, monospace; color: var(--ink); font-weight: 500; font-size: 15px; font-variant-numeric: tabular-nums; }
      .replay {
        font: inherit; font-size: 14px; color: var(--ink); background: #fff;
        border: 1px solid rgba(22,24,29,.22); border-radius: 999px; padding: 6px 14px; cursor: pointer;
        transition: border-color 160ms ease, background 160ms ease;
      }
      .replay:hover { border-color: var(--ink); }
      .replay:focus-visible, .method summary:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
      .sr-only { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
      #clock-range:focus-visible { position: static; width: 240px; height: auto; margin: 0; clip: auto; }

      /* the timeline and the page it opens */
      .tl { display: flex; flex-direction: column; gap: 28px; }
      .page { border-top: 1px solid var(--hair); padding: 22px 0 0; }
      .page-name { margin: 0; font-size: 22px; font-weight: 500; letter-spacing: -0.01em; }
      .page-facts { margin: 6px 0 14px; color: var(--muted); font-size: 15px; display: flex; flex-wrap: wrap; gap: 2px 18px; }
      .page-facts span { white-space: nowrap; }
      .page-facts b { font-size: 14px; }

      /* the wall */
      /* A flex wall, not inline text: Astro strips the whitespace between the items, and
         220 no-wrap inline items with nothing between them are one 35,000px line. */
      .wall { list-style: none; margin: 26px 0 0; padding: 0; font-size: 15px; line-height: 1.6; display: flex; flex-wrap: wrap; gap: 6px 0; }
      .wall li { max-width: 100%; }
      .wall li b { white-space: nowrap; }
      .wall li::after { content: '·'; color: rgba(22,24,29,.28); margin: 0 10px; }
      .wall li:last-child::after { content: none; }
      .wall b { font-family: 'Martian Mono', ui-monospace, monospace; font-weight: 500; font-size: 14px; margin-left: 6px; }
      .key { margin: 34px 0 0; max-width: 720px; }
      .key-ramp { height: 10px; border-radius: 2px; }
      .key-ends { display: flex; justify-content: space-between; margin-top: 6px; font-family: 'Martian Mono', ui-monospace, monospace; font-size: 14px; color: var(--muted); }
      .key-notes { margin: 14px 0 0; display: flex; flex-direction: column; gap: 4px; font-size: 14px; color: var(--muted); }
      .key-notes i { display: inline-block; width: 10px; height: 10px; border-radius: 2px; margin-right: 8px; vertical-align: -1px; }
      .key-notes b { font-family: 'Martian Mono', ui-monospace, monospace; margin-right: 8px; }

      .method { margin: 44px 0 0; border-top: 1px solid var(--hair); max-width: 68ch; }
      .method summary { cursor: pointer; padding: 14px 0; font-size: 15px; color: var(--ink); list-style: none; }
      .method summary::-webkit-details-marker { display: none; }
      .method summary::before { content: '+ '; color: var(--accent); font-weight: 600; }
      .method[open] summary::before { content: '\2212 '; }
      .method p { margin: 0 0 12px; font-size: 14px; line-height: 1.55; color: var(--muted); }
      .src { padding: 20px 0 56px; font-size: 14px; color: var(--muted); max-width: 68ch; }

      .tip {
        position: absolute; z-index: 3; pointer-events: none;
        background: #fff; border: 1px solid var(--hair);
        padding: 6px 10px; font-size: 14px; line-height: 1.3; white-space: nowrap;
        box-shadow: 0 4px 18px rgba(22, 24, 29, 0.12); border-radius: 3px;
      }

      @media (max-width: 639px) {
        .wrap { padding: 0 16px; }
        .head { padding-top: 34px; }
        h1 { font-size: 29px; }
        .stand { font-size: 15px; }
        section { padding-top: 64px; }
        section#field { padding-top: 30px; }
        h2 { font-size: 23px; }
        .deck { font-size: 16px; }
        .clock { gap: 4px 16px; margin-top: 18px; }
        .clock-day b { font-size: 32px; }
        .clock-line { font-size: 15px; width: 100%; }
        .clock-line b { font-size: 14px; }
        .replay { font-size: 13px; padding: 5px 12px; }
        figcaption, .method p, .method summary, .tip, .src, .key-ends, .key-notes { font-size: 13px; }
        .page-name { font-size: 18px; }
        .page-facts { font-size: 14px; gap: 0 14px; }
        .page-facts b { font-size: 13px; }
        .wall { font-size: 14px; line-height: 1.55; gap: 5px 0; }
        .wall li::after { margin: 0 8px; }
        .wall b { font-size: 13px; }
        /* On a phone the timeline runs down the page, so the page card sits above it and
           stays put while the reader scrolls the eleven years underneath and taps dots. */
        .tl { flex-direction: column-reverse; }
        .page {
          position: sticky; top: 0; z-index: 2; background: #fff;
          border-top: 0; border-bottom: 1px solid var(--hair);
          padding: 12px 0 10px; margin: 0 -16px; padding-left: 16px; padding-right: 16px;
          box-shadow: 0 10px 22px -16px rgba(22,24,29,.35);
        }
      }
      @media (prefers-reduced-motion: reduce) { * { transition: none !important; } html { scroll-behavior: auto; } }
    </style>

    <style is:global>
      @font-face {
        font-family: 'Martian Mono'; font-style: normal; font-weight: 400 700; font-display: swap;
        src: url('/fonts/martian-mono-var-latin.woff2') format('woff2');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: 'Martian Mono'; font-style: normal; font-weight: 400 700; font-display: swap;
        src: url('/fonts/martian-mono-var-latin-ext.woff2') format('woff2');
        unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+1E00-1E9F, U+1EF2-1EFF, U+2C60-2C7F, U+A720-A7FF;
      }
      @font-face {
        font-family: 'Schibsted Grotesk'; font-style: normal; font-weight: 400 700; font-display: swap;
        src: url('/fonts/schibsted-grotesk-var-latin.woff2') format('woff2');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: 'Schibsted Grotesk'; font-style: normal; font-weight: 400 700; font-display: swap;
        src: url('/fonts/schibsted-grotesk-var-latin-ext.woff2') format('woff2');
        unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+1E00-1E9F, U+1EF2-1EFF, U+2C60-2C7F, U+A720-A7FF;
      }
      @font-face {
        font-family: 'Archivo'; font-style: normal; font-weight: 600; font-display: swap;
        src: url('/fonts/archivo-latin-600-normal.woff2') format('woff2');
      }

      /* The plates and the readout are injected as markup, so their type is styled globally:
         Astro's scope attribute never reaches a node made by innerHTML. */
      .tip b { font-weight: 500; }
      .tip i { font-style: normal; font-family: 'Martian Mono', ui-monospace, monospace; font-size: 14px; color: #B31E63; margin-left: 6px; }
      @media (max-width: 639px) { .tip i { font-size: 13px; } }

      .plate { display: block; width: 100%; height: auto; }
      .plate text {
        font-family: 'Schibsted Grotesk', -apple-system, 'Segoe UI', Helvetica, Arial, sans-serif;
        paint-order: stroke fill; stroke: #fff; stroke-width: 3px; stroke-linejoin: round;
      }
      /* Size is emitted on each element by the mark, never set here. */
      .plate .m-name { font-weight: 500; }
      .plate .m-fig, .plate .m-tick, .plate .m-note, .plate .m-count { font-family: 'Martian Mono', ui-monospace, monospace; }
      .plate .m-note, .plate .m-count { font-weight: 600; }

      /* lighting one mark dims its field */
      .plate .m-rows [data-i] { transition: opacity 140ms linear; }
      .plate.lit .m-rows [data-i] { opacity: 0.32; }
      .plate.lit .m-rows [data-i].on { opacity: 1; }
      #leap-plate .plate.lit .m-rows [data-i].on { stroke-opacity: 1; stroke-width: 2.2; }
      #settled-plate .plate .m-rows [data-i].on { stroke: #16181D; stroke-width: 2; }
      #timeline-plate .plate .m-dots [data-i] { transform-box: fill-box; transform-origin: center; transition: transform 140ms ease, opacity 140ms linear; cursor: pointer; }
      #timeline-plate .plate .m-dots [data-i].on { fill-opacity: 1; transform: scale(1.6); }
      #timeline-plate .plate.lit .m-rings { opacity: 0.4; }

      /* the stopwatch */
      .plate .m-lab { transition: opacity 200ms linear; }
      .plate .m-lab.dim { opacity: 0.28; }
      .plate .m-needle, .plate .m-axis { touch-action: none; cursor: ew-resize; }
      .plate .m-knob { transition: r 120ms ease; }
      .plate .m-needle line { transition: opacity 260ms ease; }
      .plate .m-needle.rest line { opacity: 0; }
      .plate .m-needle:hover .m-knob { r: 12; }

      @media (prefers-reduced-motion: reduce) {
        .plate .m-rows [data-i], .plate .m-lab, .plate .m-knob { transition: none; }
      }
    </style>

    <script>
      import plate from '../gen/plate.json'
      import arrivalData from '../gen/arrival.json'
      import settleData from '../gen/settle.json'
      import weekdayData from '../gen/weekday.json'
      import sharedData from '../gen/shared.json'
      import { field } from '../lib/marks/field.js'
      import { leap, leapXAt } from '../lib/marks/leap.js'
      import { settled } from '../lib/marks/settled.js'
      import { weekdays } from '../lib/marks/weekdays.js'
      import { timeline } from '../lib/marks/timeline.js'
      import { trace } from '../lib/marks/trace.js'
      import { shortDate, nf } from '../lib/marks/util.js'

      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches
      const models = {}
      const after = {}

      // ---- draw every plate at the width the reader actually has ----------------------
      const PLATES = [
        ['field', plate, field],
        ['leap', arrivalData, leap],
        ['settled', settleData, settled],
        ['weekdays', weekdayData, weekdays],
        ['timeline', sharedData, timeline],
      ]
      for (const [key, data, mark] of PLATES) {
        const box = document.getElementById(key + '-plate')
        if (!box) continue
        let last = 0
        const draw = () => {
          const w = Math.round(box.clientWidth)
          if (!w || w === last) return
          last = w
          const m = mark(data, w)
          box.innerHTML = m.svg
          models[key] = m
          if (after[key]) after[key]()
        }
        draw()
        new ResizeObserver(draw).observe(box)
      }

      const svgOf = (box) => box.querySelector('svg')
      const local = (box, e) => { const r = svgOf(box).getBoundingClientRect(); return { x: e.clientX - r.left, y: e.clientY - r.top } }

      // Hover is a mouse affordance; touch gets a tap that takes the hold. Released on an outside
      // pointerdown and on pointercancel, never on a leave event: a tap fires pointerleave on
      // the mark right after its own pointerup, so a hold released there dies before it is read.
      function hold(box, tip, fig, o) {
        let held = false
        const show = (it, e) => {
          o.light(it)
          tip.innerHTML = o.text(it)
          tip.hidden = false
          const r = fig.getBoundingClientRect()
          const tw = tip.offsetWidth, th = tip.offsetHeight
          const px = e.clientX - r.left, py = e.clientY - r.top
          tip.style.left = Math.max(0, Math.min(r.width - tw, px + 14)) + 'px'
          tip.style.top = Math.max(0, py - th - 12) + 'px'
        }
        const clear = () => { held = false; o.clear(); tip.hidden = true }
        box.addEventListener('pointermove', (e) => { if (e.pointerType !== 'mouse' || held) return; const it = o.hit(e); if (it) show(it, e); else clear() })
        box.addEventListener('pointerdown', (e) => { if (e.pointerType === 'mouse') return; const it = o.hit(e); if (it) { held = true; show(it, e) } else clear() })
        box.addEventListener('pointerleave', (e) => { if (e.pointerType === 'mouse' && !held) clear() })
        box.addEventListener('pointercancel', clear)
        document.addEventListener('pointerdown', (e) => { if (!box.contains(e.target)) clear() })
        window.addEventListener('scroll', () => { if (!held) clear() }, { passive: true })
      }
      const lightOne = (box, i) => {
        const svg = svgOf(box); if (!svg) return
        svg.classList.add('lit')
        svg.querySelectorAll('.on').forEach((n) => n.classList.remove('on'))
        svg.querySelectorAll(`.m-rows [data-i="${i}"]`).forEach((n) => n.classList.add('on'))
      }
      const unlight = (box) => {
        const svg = svgOf(box); if (!svg) return
        svg.classList.remove('lit')
        svg.querySelectorAll('.on').forEach((n) => n.classList.remove('on'))
      }

      // ---- the stopwatch --------------------------------------------------------------
      {
        const box = document.getElementById('field-plate')
        const dayEl = document.getElementById('clock-d')
        const lineEl = document.getElementById('clock-line')
        const range = document.getElementById('clock-range')
        const replayBtn = document.getElementById('replay')
        const LAST = plate.stat.max
        const drawn = plate.stat.drawn
        const backDays = plate.rows.filter((r) => r.kind === 'back').map((r) => r.dur).sort((a, b) => a - b)
        const countBack = (d) => { let n = 0; for (const x of backDays) { if (x <= d) n++; else break } return n }
        let D = LAST
        let raf = 0
        let lastDay = -1

        const apply = () => {
          const m = models.field; const svg = svgOf(box)
          if (!m || !svg) return
          const g = m.geo
          const d = Math.max(0, Math.min(LAST, D))
          const px = g.x0 + (d / g.xmax) * g.axisW
          svg.querySelector('.m-curtain').setAttribute('x', String(d >= LAST ? g.W : Math.max(0, px)))
          const needle = svg.querySelector('.m-needle')
          needle.setAttribute('transform', `translate(${px.toFixed(2)} 0)`)
          // At rest the field is complete and the line would only cut through the names.
          needle.classList.toggle('rest', d >= LAST)
          // The words change once a day, not once a frame.
          const day = Math.round(d)
          if (day === lastDay) return
          lastDay = day
          for (const lab of svg.querySelectorAll('.m-lab')) lab.classList.toggle('dim', +lab.dataset.dur > d)
          dayEl.textContent = String(day)
          const n = countBack(d)
          lineEl.innerHTML = d >= LAST
            ? `<b>${n}</b> pages back to normal · <b>${drawn - n}</b> never returned`
            : `<b>${n}</b> pages back to normal · <b>${drawn - n}</b> still high`
          range.value = String(day)
        }
        const stop = () => { if (raf) cancelAnimationFrame(raf); raf = 0 }
        const replay = () => {
          stop()
          const T0 = performance.now(), DUR = 5200
          const step = (now) => {
            const t = Math.min(1, (now - T0) / DUR)
            D = LAST * t * t            // slow where most of the pages come back, fast through the tail
            apply()
            if (t < 1) raf = requestAnimationFrame(step); else raf = 0
          }
          raf = requestAnimationFrame(step)
        }

        const bind = () => {
          const svg = svgOf(box); const g = models.field.geo
          const toDay = (clientX) => {
            const r = svg.getBoundingClientRect()
            return Math.max(0, Math.min(LAST, (((clientX - r.left) - g.x0) / g.axisW) * g.xmax))
          }
          let dragging = false
          const down = (e) => { e.preventDefault(); e.stopPropagation(); stop(); dragging = true; e.currentTarget.setPointerCapture(e.pointerId); D = toDay(e.clientX); apply() }
          const move = (e) => { if (!dragging) return; D = toDay(e.clientX); apply() }
          const up = () => { dragging = false }
          for (const el of [svg.querySelector('.m-needle'), svg.querySelector('.m-axis')]) {
            el.addEventListener('pointerdown', down)
            el.addEventListener('pointermove', move)
            el.addEventListener('pointerup', up)
            el.addEventListener('pointercancel', up)
          }
        }
        after.field = () => { lastDay = -1; apply(); bind() }
        after.field()

        replayBtn.addEventListener('click', replay)
        range.addEventListener('input', () => { stop(); D = +range.value; apply() })
        if (!reduced) setTimeout(replay, 600)

        hold(box, document.getElementById('field-tip'), document.getElementById('field-fig'), {
          hit: (e) => {
            const m = models.field; if (!m) return null
            const { x, y } = local(box, e)
            if (y < m.geo.top - 3 || y > m.geo.bottom + 3 || x > m.geo.x1 + 50) return null
            let best = null, bd = 5
            for (const row of m.rows) { const dd = Math.abs(row.top + row.h / 2 - y); if (dd < bd) { bd = dd; best = row } }
            return best
          },
          text: (row) => `<b>${row.t}</b><i>${row.kind === 'back' ? row.dur + (row.dur === 1 ? ' day' : ' days') : row.kind === 'holdout' ? 'never returned' : 'too recent to say'}</i>`,
          light: (row) => {
            lightOne(box, row.i)
            const svg = svgOf(box), g = models.field.geo
            const hi = svg.querySelector('.m-hi')
            const end = row.kind === 'back' ? g.x0 + (row.dur / g.xmax) * g.axisW : g.W
            hi.setAttribute('x', String(g.x0 - 1)); hi.setAttribute('y', String(row.top - 1.5))
            hi.setAttribute('width', String(Math.max(3, end - g.x0 + 2))); hi.setAttribute('height', String(row.h + 3))
          },
          clear: () => { unlight(box); const svg = svgOf(box); if (svg) svg.querySelector('.m-hi').setAttribute('width', '0') },
        })
      }

      // ---- the leap -------------------------------------------------------------------
      {
        const box = document.getElementById('leap-plate')
        hold(box, document.getElementById('leap-tip'), document.getElementById('leap-fig'), {
          hit: (e) => {
            const m = models.leap; if (!m) return null
            const { x, y } = local(box, e)
            if (y < m.geo.top - 4 || y > m.geo.bot + 4) return null
            const py = Math.max(m.geo.top, Math.min(m.geo.bot, y))
            let best = null, bd = 7
            for (const r of m.rows) { const dd = Math.abs(leapXAt(m.geo, r, py) - x); if (dd < bd) { bd = dd; best = r } }
            return best
          },
          text: (r) => `<b>${r.t}</b><i>${nf.format(r.before)} → ${nf.format(r.peak)}</i>`,
          light: (r) => lightOne(box, r.i),
          clear: () => unlight(box),
        })
      }

      // ---- the squares ----------------------------------------------------------------
      {
        const box = document.getElementById('settled-plate')
        const fmt = (v) => (v >= 100 ? Math.round(v) : v >= 10 ? v.toFixed(1) : v >= 1 ? v.toFixed(2) : v.toPrecision(2)).toString().replace(/\.0+$/, '')
        hold(box, document.getElementById('settled-tip'), document.getElementById('settled-fig'), {
          hit: (e) => {
            const m = models.settled; if (!m) return null
            const { x, y } = local(box, e)
            let best = null, bd = Infinity
            for (const r of m.rows) { const dd = Math.max(Math.abs(r.cx - x), Math.abs(r.cy - y)); if (dd < bd) { bd = dd; best = r } }
            return best && bd <= best.side * 0.8 ? best : null
          },
          text: (r) => `<b>${r.t}</b><i>${fmt(r.x)}× its normal level</i>`,
          light: (r) => lightOne(box, r.i),
          clear: () => unlight(box),
        })
      }

      // ---- the timeline, and the page it opens ----------------------------------------
      {
        const box = document.getElementById('timeline-plate')
        const pbox = document.getElementById('page-plate')
        const nameEl = document.getElementById('page-name')
        const factsEl = document.getElementById('page-facts')
        const pts = sharedData.points
        let picked = pts.indexOf(pts.reduce((m, p) => (p.peak > m.peak ? p : m), pts[0]))
        let pages = null, pagesP = null, current = null, byTitle = null
        const loadPages = () => pagesP || (pagesP = import('../gen/pages.json').then((m) => {
          pages = m.default
          byTitle = new Map(pages.rows.map((r) => [r.t, r]))
          if (!current) current = byTitle.get(pts[picked].t)
          drawPage()
          return pages
        }))
        const hit = (e) => {
          const m = models.timeline; if (!m) return null
          const { x, y } = local(box, e)
          let best = null, bd = m.geo.r + 5
          for (const r of m.rows) { const dd = Math.hypot(r.cx - x, r.cy - y); if (dd < bd) { bd = dd; best = r } }
          return best
        }
        const showPick = () => {
          const m = models.timeline, svg = svgOf(box); if (!m || !svg) return
          const r = m.rows[picked]; const c = svg.querySelector('.m-pick')
          c.setAttribute('cx', String(r.cx)); c.setAttribute('cy', String(r.cy))
        }
        after.timeline = showPick
        showPick()

        let lastW = 0
        const drawPage = () => {
          if (!current || !pages) return
          const w = Math.round(pbox.clientWidth); if (!w) return
          lastW = w
          pbox.innerHTML = trace(current, plate.stops, pages.meta.days, w).svg
        }
        new ResizeObserver(() => { if (Math.round(pbox.clientWidth) !== lastW) drawPage() }).observe(pbox)

        const select = async (i) => {
          picked = i; showPick()
          await loadPages()
          current = byTitle.get(pts[i].t)
          if (!current) return
          nameEl.textContent = current.t
          const facts = [
            `Record day <b>${shortDate(current.d)}</b>`,
            `<b>${nf.format(current.peak)}</b> views that day`,
            current.before === null ? null : `<b>${nf.format(current.before)}</b> the day before`,
            current.kind === 'back' ? `Back to normal on day <b>${current.dur}</b>`
              : current.kind === 'holdout' ? `Still above twice normal a full year later`
              : current.kind === 'running' ? `Record day too recent to tell`
              : `No normal level in the month before`,
          ].filter(Boolean)
          factsEl.innerHTML = facts.map((f) => `<span>${f}</span>`).join('')
          drawPage()
        }
        box.addEventListener('click', (e) => { const r = hit(e); if (r) select(r.i) })
        hold(box, document.getElementById('timeline-tip'), document.getElementById('timeline-fig'), {
          hit,
          text: (r) => `<b>${r.t}</b><i>${shortDate(r.d)} · ${nf.format(r.peak)}</i>` + (r.n > 1 ? `<br>one of ${r.n} pages on this date` : ''),
          light: (r) => lightOne(box, r.i),
          clear: () => unlight(box),
        })
        const idle = window.requestIdleCallback || ((f) => setTimeout(f, 1200))
        idle(() => loadPages())
      }

      // ---- the reveals: each mark is complete without them; they only replay its drawing ---
      if (!reduced) {
        const wipe = (key) => {
          const box = document.getElementById(key + '-plate'); const svg = svgOf(box)
          const rect = svg && svg.querySelector('.m-wipe'); if (!rect) return
          const W = +rect.getAttribute('width'), H = +rect.getAttribute('height')
          const mode = key === 'timeline' ? (models.timeline.geo.phone ? 'down' : 'across') : key === 'weekdays' || key === 'leap' || key === 'settled' ? 'up' : 'across'
          // A hidden tab has no animation frames, so it gets the finished mark and no replay.
          if (document.visibilityState === 'hidden') return
          const DUR = key === 'timeline' ? 1800 : 1100
          const T0 = performance.now()
          const ease = (t) => 1 - Math.pow(1 - t, 3)
          const set = (t) => {
            if (mode === 'across') rect.setAttribute('width', String(W * t))
            else if (mode === 'down') rect.setAttribute('height', String(H * t))
            else { rect.setAttribute('y', String(H * (1 - t))); rect.setAttribute('height', String(H * t)) }
          }
          set(0)
          // The frame timestamp can predate T0 by a few milliseconds, so t is clamped at both ends.
          const step = (now) => { const t = ease(Math.max(0, Math.min(1, (now - T0) / DUR))); set(t); if (t < 1) requestAnimationFrame(step) }
          requestAnimationFrame(step)
          setTimeout(() => set(1), DUR + 250)
        }
        const seen = new Set()
        const io = new IntersectionObserver((es) => {
          for (const e of es) {
            if (!e.isIntersecting) continue
            const key = e.target.dataset.reveal
            if (seen.has(key)) continue
            seen.add(key); io.unobserve(e.target); wipe(key)
          }
        }, { threshold: 0.2 })
        for (const el of document.querySelectorAll('[data-reveal]')) io.observe(el)

        const wall = document.getElementById('wall')
        const io2 = new IntersectionObserver((es) => {
          if (!es.some((e) => e.isIntersecting)) return
          io2.disconnect()
          wall.querySelectorAll('li').forEach((li, i) => li.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 420, delay: Math.min(i, 120) * 9, fill: 'backwards', easing: 'ease-out' }))
        }, { threshold: 0.05 })
        io2.observe(wall)
      }

      // ---- where the reader is --------------------------------------------------------
      {
        const bar = document.getElementById('progress-bar')
        const on = () => { const h = document.documentElement.scrollHeight - innerHeight; bar.style.transform = `scaleX(${h > 0 ? Math.min(1, scrollY / h) : 0})` }
        addEventListener('scroll', on, { passive: true }); addEventListener('resize', on); on()
      }
    </script>
  </body>
</html>
